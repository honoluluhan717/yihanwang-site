replace exposure_final="High" if exp4_imputed=="High"
replace exposure_final="Very High" if exp4_imputed=="Very High"
replace exposure_final="" if exp4_imputed=="M" | exp4_imputed==""
tab exposure_final

drop _merge 

save "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\FK250117_eaq_to_merge.dta",replace 




H="get BMI ready "
* Step 1: Load and keep needed BMI variables;
import delimited "\\mssm2\mssm2$\wangy63\Personal\DesktopFiles\DC_FK Frailty assessment\FK250117 Frailty\FK250117_PE.csv", clear
keep patient_id visit_number height_in weight_lb bmi_lbin
sort patient_id visit_number


* Step 2: Merge with crosswalk file (must have first_name and last_name in both)
import delimited "\\mssm2\mssm2$\wangy63\Personal\DesktopFiles\DC_FK Frailty assessment\FK250117 Frailty\Fk250117_demographics.csv", clear
merge 1:m patient_id using "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\PE.dta"

keep if _merge == 3  // Keep matched observations only
drop _merge
sort patient_id visit_number
duplicates drop patient_id visit_number, force
save "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\PEx.dta", replace

* Step 3: Clean height and weight
use "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\PEx.dta", clear

gen visit_Num = visit_number
drop visit_number

gen height_orig = height_in
gen weight_orig = weight_lb

destring height_in,replace ignore("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ ,:()$")
destring height_orig,replace ignore("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ ,:()$")
destring weight_lb,replace ignore("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ ,:()$")
destring weight_orig,replace ignore("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ ,:()$")

replace height_in = . if height_in == 999 | height_in <= 0
replace weight_lb = . if weight_lb == 999 | weight_lb <= 0

* Round weight to nearest 0.1
replace weight_lb = round(weight_lb, 0.1) if !missing(weight_lb)

* Remove extreme values
replace height_in = . if height_in <= 53 | height_in >= 84
replace weight_lb = . if weight_lb <= 75 | weight_lb >= 600

rename bmi_lbin bmi_kgm

save "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\BMI_raw.dta", replace

* Step 4: Recalculate BMI in kg/m² accounting for data availability
use "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\BMI_raw.dta", clear

gen double bmi_kgmR = .

gen double kg = weight_lb / 2.2046226
gen double m = height_in * 0.0254
gen double orig_kg = weight_orig / 2.2046226
gen double orig_m = height_orig * 0.0254

destring bmi_kgm, replace ignore("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ ,:()$")

replace bmi_kgm = kg / (m^2) if !missing(kg) & !missing(m)
replace bmi_kgmR = round(bmi_kgm, 0.1) if !missing(bmi_kgm)

replace bmi_kgm = orig_kg / (m^2) if missing(weight_lb) & !missing(height_in)
replace bmi_kgm = kg / (orig_m^2) if !missing(weight_lb) & missing(height_in)
replace bmi_kgm = orig_kg / (orig_m^2) if missing(weight_lb) & missing(height_in)

save "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\BMIx.dta", replace

* Step 5: Calculate mean BMI per patient
use "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\BMIx.dta", clear
collapse (mean) bmi_kgm, by(patient_id)
gen BMI_mean = round(bmi_kgm, 0.1)
drop bmi_kgm
save "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\BMI_mean.dta", replace

* Step 6: Categorize BMI into CDC groups
gen bmi_Group = ""

replace bmi_Group = "Not reported" if BMI_mean < 0
replace bmi_Group = "Underweight"  if BMI_mean > 0 & BMI_mean < 18.5
replace bmi_Group = "Normal"       if BMI_mean >= 18.5 & BMI_mean < 25
replace bmi_Group = "Overweight"   if BMI_mean >= 25   & BMI_mean < 30
replace bmi_Group = "Obese"        if BMI_mean >= 30

tab bmi_Group
rename patient_id ptid 

save "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\PE_to_merge.dta", replace

H="get age at most recent visit (Ahmad)"
* Step 1: Load the visits data
import delimited "\\mssm2\mssm2$\wangy63\Personal\DesktopFiles\DC_FK Frailty assessment\FK250117 Frailty\Fk250117_visits_marital_work.csv", clear

* Step 2: Sort to get most recent visit per patient
gen visit_date_num = date(visit_date, "YMD") if !missing(visit_date)  // format if not already numeric
format visit_date_num %td

bysort patient_id (visit_number): gen tag = (_n == _N)   // tag most recent visit per patient

keep if tag == 1
rename visit_number last_visit
rename visit_date_num last_visdt
keep patient_id last_visit last_visdt
rename patient_id ptid
save "last_visits.dta", replace

* Step 3: Load demographics and merge
use "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\Fk250117_demographics.dta", clear
gen dob_num = date(dob, "MDY") if !missing(dob)  // convert dob to numeric
format dob_num %td

merge 1:1 ptid using "last_visits.dta"

* Step 4: Calculate age at most recent visit
gen lastVis_Age = floor((last_visdt - dob_num)/365.25)

gen age_cat=.
replace age_cat=0 if lastVis_Age>=50 & lastVis_Age<=60
replace age_cat=1 if lastVis_Age>=61 & lastVis_Age<70
replace age_cat=2 if lastVis_Age>=70
label define age_cat 0 "50-60 years" 1 "61-70" 2 "70+ years"
label values age_cat age_cat
tab age_cat,m

//recode race 
gen race_cat=.
replace race_cat=0 if racehispanic=="White NH / Caucasian"
replace race_cat=1 if racehispanic=="Black (H and NH) / African"
replace race_cat=2 if racehispanic=="Hispanic (not Black) / Mexican"
replace race_cat=3 if racehispanic==" Asian NH" | racehispanic=="M" | racehispanic=="Other NH"
label define race_cat 0 "White" 1 "Black" 2 "Hispanic" 3 "Other"
label values race_cat race_cat
tab race_cat

drop _merge 

save "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\Fk250117_demographics_to_merge.dta",replace



H="merge all data "
use "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\redcap_to_merge.dta",clear 
rename record_id ptid 
destring ptid, replace 
rename dob dob_redcap 

//merge to demographics 
merge 1:1 ptid using "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\Fk250117_demographics.dta"
list ptid if _merge==1 //IDs that only exist in the Redcap data 
list ptid if _merge==2 //IDs that only exist in the demographics data 
keep if _merge==3
drop _merge

//merge to exporesure data 
merge 1:1 ptid using "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\FK250117_eaq_to_merge2.dta"
drop _merge 

//merge to pre911 occupation data 
merge 1:1 ptid using "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\FK250117_eaq_to_merge.dta"
drop _merge 

//merge to BMI data 
merge 1:1 ptid using "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\PE_to_merge.dta"
drop _merge 

drop if jhu_score==.

save "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\final data\final_ags_data.dta",replace 

H="get tables ready "
log using "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\output\ags_output_forChinmayi_v2.smcl",replace 

use "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\final data\final_ags_data.dta",clear 


//calculate age at time of survey 
gen age_survey = (SurveyDate - dob_redcap) / 365.25
format age_survey %9.2f
gen age_survey_floor = floor((SurveyDate - dob_redcap) / 365.25)
tab age_survey_floor
gen age_cat=.
replace age_cat=0 if age_survey_floor>=50 & age_survey_floor<=54 
replace age_cat=1 if age_survey_floor>=55 & age_survey_floor<=64 
replace age_cat=2 if age_survey_floor>=65

label define age_cat 0 "50-54" 1 "55-64" 2 "65+"
label values age_cat age_cat

//create race 
gen str20 race_cat=""
replace race_cat="White" if racehispanic=="White NH / Caucasian"
replace race_cat="Black" if racehispanic=="Black (H and NH) / African"
replace race_cat="Other" if racehispanic=="Other NH" | racehispanic=="Asian NH" | racehispanic=="Hispanic (not Black) / Mexican"
replace race_cat="Not Reported" if racehispanic=="M"
tab race_cat

tab jhu_frail_flag
tab jhu_cat

tab frail_cat
tab frail_flag

////create 3 group bmi 
gen bmi_Group3=.

replace bmi_Group3=0 if bmi_Group=="Normal" | bmi_Group=="Underweight"
replace bmi_Group3=1 if bmi_Group=="Overweight"
replace bmi_Group3=2 if bmi_Group=="Obese"

label define bmi_Group3 0 "Normal/Underweight" 1 "Overweight" 2 "Obese"
label values bmi_Group3 bmi_Group3
tab bmi_Group3

//create 3 group exposure 
gen exposure_final3=.

replace exposure_final3=0 if exposure_final=="Low"
replace exposure_final3=1 if exposure_final=="Intermediate"
replace exposure_final3=2 if exposure_final=="High" | exposure_final=="Very High"

label define exposure_final3 0 "Low" 1 "Intermediate" 2 "High/Very High"
label values exposure_final3 exposure_final3
tab exposure_final3

//table1 
tab age_cat,m
tab gender,m
tab race_cat,m
tab exposure_final3,m
tab soc_4_categories,m
tab bmi_Group,m
tab Hasthisparticipantbeenshown,m

tab age_cat frail_flag,m
tab gender frail_flag,m
tab race_cat frail_flag,m
tab exposure_final3 frail_flag,m
tab soc_4_categories frail_flag,m
tab bmi_Group frail_flag,m
tab Hasthisparticipantbeenshown frail_flag,m

tab age_cat jhu_frail_flag,m
tab gender jhu_frail_flag,m
tab race_cat jhu_frail_flag,m
tab exposure_final3 jhu_frail_flag,m
tab soc_4_categories jhu_frail_flag,m
tab bmi_Group jhu_frail_flag,m
tab Hasthisparticipantbeenshown jhu_frail_flag,m

//table2 
tab frail_cat jhu_cat,chi2


//table3 
kap frail_flag jhu_frail_flag
kappaetc frail_flag jhu_frail_flag, wgt(linear)
kappaetc frail_flag jhu_frail_flag, wgt(quadratic)

//table4
diagt frail_flag jhu_frail_flag, exact

//table5
diagt frail_flag jhu_frail_flag if age_cat==0, exact 
diagt frail_flag jhu_frail_flag if age_cat==1 , exact 
diagt frail_flag jhu_frail_flag if age_cat==2 , exact 

diagt frail_flag jhu_frail_flag if gender=="Female", exact
diagt frail_flag jhu_frail_flag if gender=="Male", exact

diagt frail_flag jhu_frail_flag if race_cat=="White", exact
diagt frail_flag jhu_frail_flag if race_cat=="Black", exact
diagt frail_flag jhu_frail_flag if race_cat=="Other", exact
*diagt frail_flag jhu_frail_flag if race_cat=="Not Reported", exact

diagt frail_flag jhu_frail_flag if exposure_final3==0, exact
diagt frail_flag jhu_frail_flag if exposure_final3==1, exact
diagt frail_flag jhu_frail_flag if exposure_final3==2, exact

diagt frail_flag jhu_frail_flag if bmi_Group3==0, exact
diagt frail_flag jhu_frail_flag if bmi_Group3==1, exact
diagt frail_flag jhu_frail_flag if bmi_Group3==2, exact

diagt frail_flag jhu_frail_flag if soc_4_categories=="Construction", exact
diagt frail_flag jhu_frail_flag if soc_4_categories=="Protective", exact
*diagt frail_flag jhu_frail_flag if soc_4_categories=="SOC37&49", exact
diagt frail_flag jhu_frail_flag if soc_4_categories=="residual", exact

//table5
tab fesi_cat jhu_cat,m chi2
tab moca_catags jhu_cat,m chi2
tab adl_cat jhu_cat,m chi2
tab callahan_cat jhu_cat,m chi2
tab Hasthisparticipantbeenshown jhu_cat,m chi2

tab fesi_cat frail_cat,m chi2
tab moca_catags frail_cat,m chi2
tab adl_cat frail_cat,m chi2
tab callahan_cat frail_cat,m chi2
tab Hasthisparticipantbeenshown frail_cat,m chi2

translate "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\output\ags_output_forChinmayi_v2.smcl" "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\output\ags_output_forChinmayi_v2.pdf"

log close 





H="get Hannah's tables ready "
log using "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\output\ags_output_forHannah_v5.smcl",replace 

use "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\final data\final_ags_data.dta",clear 


//calculate age at time of survey 
gen age_survey = (SurveyDate - dob_redcap) / 365.25
