rename patient_id ptid

merge 1:1 ptid using "\\mssm2\mssm2$\wangy63\Personal\DesktopFiles\DC_FK Frailty assessment\FK250117 Frailty\FK250117_eaq.dta"
tab exp4_imputed,m
gen str20 exposure_final=""
replace exposure_final="Low" if exp4_imputed=="Low"
