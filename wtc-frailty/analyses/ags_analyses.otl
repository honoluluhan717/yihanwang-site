= V4 Outline MultiLine NoSorting TabWidth=30

H="get data ready "
import  excel "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\initial data\WTCII_REPORT_4.24.2025.xlsx",clear firstrow
rename RecordID record_id
drop if record_id=="88"
replace record_id="16" if record_id=="16 (withdrawn)"
replace record_id="50" if record_id=="50 (withdrawn)"
replace record_id="86" if record_id=="86 (withdrawn)"
replace record_id="88" if record_id=="88 (Withdrawn)"
save "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\initial data\WTCII_REPORT_4.24.2025.dta",replace 

import excel "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\initial data\WTCIISubjectTracking_4.24.2025.xlsx",clear firstrow
rename PatientID record_id
rename DateofBirth dob
rename Gender gender 
tostring record_id,replace 
save "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\initial data\WTCIISubjectTracking_4.24.2025.dta",replace 

use "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\initial data\WTCII_REPORT_4.24.2025.dta"
merge 1:1 record_id using "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\initial data\WTCIISubjectTracking_4.24.2025.dta"
drop _merge


//drop who did not complete JHU questionnaire 
drop if JHUScore==.
tab JHUScore

//fill those missing Callahan score on Redcap 
**#88; #1175; #1577; #4855 has actual missing scores 
replace CallahanScore=6 if record_id=="3"
replace CallahanScore=6 if record_id=="26"
replace CallahanScore=6 if record_id=="28"
replace CallahanScore=6 if record_id=="36"
replace CallahanScore=6 if record_id=="45"
replace CallahanScore=6 if record_id=="46"

//rename a bunch of variables 
rename JHUScore jhu_score
rename FESITotalmax64 fesi_total
rename MOCATotalMax30 moca_total
rename ADLscore adl_score
rename CallahanScore callahan_score

//create JHU frail flag & frail scale flag 
**VALUE JHU
**0 = 'Not Frail/Robust Health'
**1-2 = 'Pre-Frail'
**3-5 = 'Frail'
**. = 'Missing' ;


gen jhu_cat=.
replace jhu_cat=0 if jhu_score==0 
replace jhu_cat=1 if jhu_score==1 | jhu_score==2 
replace jhu_cat=2 if jhu_score==3 | jhu_score==4 | jhu_score==5

label define jhu_cat 0 "Not Frail/Robust Health" 1 "Pre-Frail" 2 "Frail"
label values jhu_cat jhu_cat
tab jhu_cat,m

gen jhu_frail_flag=.
replace jhu_frail_flag=0 if jhu_cat==0
replace jhu_frail_flag=1 if jhu_cat==1 | jhu_cat==2 

label define jhu_frail_flag 0 "Not Frail/Robust Health" 1 "Pre-Frail/Frail"
label values jhu_frail_flag jhu_frail_flag 

tab jhu_frail_flag


//create frail scale 
gen frail_cat=.
replace frail_cat=0 if FRAILScaleScore==0
replace frail_cat=1 if FRAILScaleScore==1 | FRAILScaleScore==2
replace frail_cat=2 if FRAILScaleScore>=3
tab frail_cat

label define frail_cat 0 "Not Frail" 1 "Pre-Frial" 2 "Frail"
label values frail_cat frail_cat
tab frail_cat,m

gen frail_flag=.
replace frail_flag=0 if frail_cat==0 
replace frail_flag=1 if frail_cat==1 | frail_cat==2

label define frail_flag 0 "Not Frail" 1 "Pre-Frail/Frail"
label values frail_flag frail_flag
tab frail_flag,m

//recode clinical scales 
gen fesi_cat=.
replace fesi_cat=0 if fesi_total>=16 & fesi_total<=19
replace fesi_cat=1 if fesi_total>=20 & fesi_total<=27
replace fesi_cat=2 if fesi_total>=28 & fesi_total<64 
label define fesi_cat 0 "Low Concern" 1 "Moderate Concern" 2 "High Concern"
label values fesi_cat fesi_cat
tab fesi_cat,m

gen moca_catags=.
replace moca_catags=0 if moca_total>=26 & moca_total<=31
replace moca_catags=1 if moca_total>=18 & moca_total<=25
replace moca_catags=2 if moca_total>=10 & moca_total<=17
replace moca_catags=3 if moca_total>=0 & moca_total<=9
label define moca_catags 0 "Normal" 1 "Mild cognitive impairment" 2 "Moderate cognitive impairment" 3 "Severe cognitive impairment"
label values moca_catags moca_catags
tab moca_catags,m

gen adl_cat=.
replace adl_cat=0 if adl_score<24
replace adl_cat=1 if adl_score>=24
replace adl_cat=2 if adl_score<0
label define adl_cat 0 "Not fully independent" 1 "Independent" 2 "Unknown"
label values adl_cat adl_cat
tab adl_cat

gen callahan_cat=.
replace callahan_cat=0 if callahan_score==0 | callahan_score==1 | callahan_score==2 | callahan_score==3
replace callahan_cat=1 if callahan_score==4 | callahan_score==5 | callahan_score==6
label define callahan_cat 0 "Impairment likely" 1 "Not impaired"
label values callahan_cat callahan_cat
tab callahan_cat

//fall assessment score 
tab FallsAssessmentScore

save "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\redcap_to_merge.dta",replace 








H="get exposure severity"

//get exposure severity ready 
// Load the dataset
import delimited "\\mssm2\mssm2$\wangy63\Personal\DesktopFiles\DC_FK Frailty assessment\FK250117 Frailty\FK250117_eaq.csv", clear

/*Exposure data from EAQ visit 1(asbestos, etc...)*/
local asbestos    eaq_02_06   eaq_03_06   eaq_04_06   eaq_05_06   eaq_06_06   eaq_07_06   eaq_00_06   eaq_000_06
local cadmium    eaq_02_08   eaq_03_08   eaq_04_08   eaq_05_08   eaq_06_08   eaq_07_08   eaq_00_08   eaq_000_08
local diesel    eaq_02_10   eaq_03_10   eaq_04_10   eaq_05_10   eaq_06_10   eaq_07_10   eaq_00_10   eaq_000_10
/*dust general*/
local dustgen    eaq_02_12   eaq_03_12   eaq_04_12   eaq_05_12   eaq_06_12   eaq_07_12   eaq_00_12   eaq_000_12
/*dust mineral or mining*/
local dustmin    eaq_02_14   eaq_03_14   eaq_04_14   eaq_05_14   eaq_06_14   eaq_07_14   eaq_00_14   eaq_000_14
/*dust silica/sand*/
local silica    eaq_02_16   eaq_03_16   eaq_04_16   eaq_05_16   eaq_06_16   eaq_07_16   eaq_00_16   eaq_000_16
/*dust wood*/
local wood    eaq_02_18   eaq_03_18   eaq_04_18   eaq_05_18   eaq_06_18   eaq_07_18   eaq_00_18   eaq_000_18
/*ergonomic risk factors*/
local ergonom    eaq_02_20   eaq_03_20   eaq_04_20   eaq_05_20   eaq_06_20   eaq_07_20   eaq_00_20   eaq_000_20
local fiberglass    eaq_02_22   eaq_03_22   eaq_04_22   eaq_05_22   eaq_06_22   eaq_07_22   eaq_00_22   eaq_000_22
/*heat/cold stress*/
local heat    eaq_02_24   eaq_03_24   eaq_04_24   eaq_05_24   eaq_06_24   eaq_07_24   eaq_00_24   eaq_000_24
/*industrial cleaning solutions*/
local industry    eaq_02_26   eaq_03_26   eaq_04_26   eaq_05_26   eaq_06_26   eaq_07_26   eaq_00_26   eaq_000_26
local lead    eaq_02_28   eaq_03_28   eaq_04_28   eaq_05_28   eaq_06_28   eaq_07_28   eaq_00_28   eaq_000_28
local mercury    eaq_02_30   eaq_03_30   eaq_04_30   eaq_05_30   eaq_06_30   eaq_07_30   eaq_00_30   eaq_000_30
local noise    eaq_02_32   eaq_03_32   eaq_04_32   eaq_05_32   eaq_06_32   eaq_07_32   eaq_00_32   eaq_000_32
/*non-diesel exhaust*/
local nondiesel    eaq_02_34   eaq_03_34   eaq_04_34   eaq_05_34   eaq_06_34   eaq_07_34   eaq_00_34   eaq_000_34
/*pesticides*/
local pest    eaq_02_36   eaq_03_36   eaq_04_36   eaq_05_36   eaq_06_36   eaq_07_36   eaq_00_36   eaq_000_36
/*smoke (non-cigarette)*/
local noncig    eaq_02_38   eaq_03_38   eaq_04_38   eaq_05_38   eaq_06_38   eaq_07_38   eaq_00_38   eaq_000_38
/*solvents/gasoline*/
local gasoline    eaq_02_40   eaq_03_40   eaq_04_40   eaq_05_40   eaq_06_40   eaq_07_40   eaq_00_40   eaq_000_40
/*welding fumes or brazing*/
local welding    eaq_02_42   eaq_03_42   eaq_04_42   eaq_05_42   eaq_06_42   eaq_07_42   eaq_00_42   eaq_000_42
/*other*/
/*  eaq_02_44   eaq_03_44   eaq_04_44   eaq_05_44   eaq_06_44   eaq_07_44   eaq_00_44   eaq_000_44(excluded since these are free-txt)0*/


// Loop through each exposure group
local exposures asbestos cadmium diesel dustgen dustmin silica wood ergonom fiberglass ///
                heat industry lead mercury noise nondiesel pest noncig gasoline welding

foreach var in `exposures' {

    // Create the binary exposure indicator and initialize to 0
    gen `var' = 0

    // Loop through the 8 variable names stored in the macro
    forvalues i = 1/8 {
        local v : word `i' of ``var''
        replace `var' = `var'+1 if `v' == "Yes"
    }
}

foreach var in asbestos cadmium diesel dustgen dustmin silica wood ergonom fiberglass ///
             heat industry lead mercury noise nondiesel pest noncig gasoline welding {
			 	tab `var'
			 }
			 


