H="get pre911 occupation"

//get pre-911 occupation ready 
// Load the dataset
import delimited "\\mssm2\mssm2$\wangy63\Personal\DesktopFiles\DC_FK Frailty assessment\FK250117 Frailty\FK250117_eaq.csv", clear
rename patient_id ptid 

// Initialize occupation and group variables
gen pre9110ccup = ""
gen pre911_group = ""

// Map EAQ_01_04 to detailed occupations
replace pre9110ccup = "11: Management Occupations" if inlist(eaq_01_04, ///
    "DirectorofBuildingandCodeEnforcement,TownofQueensbury", "ExecutivePresident", ///
    "SecruityManager", "accountmanage", "executiveasst.", "manager", "supervisor park department")

replace pre9110ccup = "15: Computer & Mathematical Occupations" if eaq_01_04 == "Computer Security"

replace pre9110ccup = "17: Architecture and Mathematical Occupations" if inlist(eaq_01_04, ///
    "DOTURBANPLANNER", "EngineerfortheBoardofEducation")

replace pre9110ccup = "19: Life, Physical, and Social Science Occupations" if inlist(eaq_01_04, ///
    "SciencetistArchaeology", "Research Scientist")

replace pre9110ccup = "23: Legal Occupations" if inlist(eaq_01_04, ///
    "NYStatecourtofficer", "courtofficer")

replace pre9110ccup = "27: Arts, Design, Entertainment, Sports & Media Occupations" if inlist(eaq_01_04, ///
    "Artist", "BroadcastEngineer", "Producer/Director", "consultant/audioengineer")

replace pre9110ccup = "31: Healthcare Support Occupations" if inlist(eaq_01_04, ///
    "PARAMEDIC", "registerednurse")

replace pre9110ccup = "33: Protective Service Occupations" if inlist(eaq_01_04, ///
    "Commander-centralparkprecinct", "DeputyInspector-NYPD", "DeputySheriff", "Detective", ///
    "DetectiveforNYPD", "Firefighter/asstchief", "MTAPOLICEDEPARTMENT", "N.Y.P.D-PoliceOfficer") | inlist(eaq_01_04,  ///
	"NYPD", "NYPD DETECTIVE", "NYPDPoliceOfficer", "NYPDTraffic/TowTruckOperator", ///
    "NYPoliceSergeant", "PENNSYLVANIA STATE CONSTABLE", "POLICE OFFICER", "Police") | inlist(eaq_01_04, ///
	"Police Officer", "PoliceOfficer", "PoliceOfficerLT.", "PoliceSgt.", "SargentNYPD", "Sergaent", ///
    "Sergeant", "Sergeant with Queen's DA office") | inlist(eaq_01_04, "captainnypd", "detective", "firefighter" ///
    "newyorkcitydetective", "nypd", "nys zone seargent", "policeofficer", "sargent") | inlist(eaq_01_04, "sergeant" ///
	"state of ny fire saftey", "state trooper", "NYCPoliceOfficer", "PoliceOfficer")

replace pre9110ccup = "37: Building and Grounds Cleaning and Maintenance Occupations" if inlist(eaq_01_04, ///
    "MAINTENANCEFEDERALRESERVEBANK", "sanitationworker", "windowcleaner")

replace pre9110ccup = "43: Office and Administrative Support Occupations" if inlist(eaq_01_04, ///
    "CentralOffice", "ClericalAssociate", "Procurement-OfficeofChiefMedicalExaminer")

replace pre9110ccup = "45: Farming, Fishing, and Forestry Occupations" if inlist(eaq_01_04, ///
    "Enviromentalprogramspecialist", "envirmental conservation officer", "TimberMan")

replace pre9110ccup = "47: Construction Occupations" if inlist(eaq_01_04, ///
    "Carpenter", "Mason", "Plumber", "TowOperator", "Bricklayer", "contruction officer", "ironworker")

replace pre9110ccup = "49: Electrical, Telecommunications & Other Installation & Repair" if inlist(eaq_01_04, ///
    "Field Technician for Verizon", "electrician", "fed tech", "lighttech", "Electrician", "fieldtech")

replace pre9110ccup = "53: Transportation and Material Movers" if inlist(eaq_01_04, ///
    "3rdrailoperations(nycta)", "NYCTransitmachinist", "TBTABRIDGESANDTUNNELS", "Busoperator")

replace pre9110ccup = "55: Military Specific Occupations" if inlist(eaq_01_04, ///
    "In the Army", "NYS TROOPER")

replace pre9110ccup = "RETIRED" if inlist(eaq_01_04, "retired", "Retired")

replace pre9110ccup = "UNEMPLOYED" if eaq_01_04 == "unemployed"

replace pre9110ccup = "UNKNOWN" if eaq_01_04 == "same"


// Categorize pre9110ccup into grouped occupation classes
replace pre911_group = "Protective Services/Military" if inlist(pre9110ccup, ///
    "33: Protective Service Occupations", "55: Military Specific Occupations")

replace pre911_group = "Construction" if pre9110ccup == "47: Construction Occupations"

replace pre911_group = "Electrical, Telecom, Other Install/Repair" if ///
    pre9110ccup == "49: Electrical, Telecommunications & Other Installation & Repair"

replace pre911_group = "Transportation and Material Moving" if ///
    pre9110ccup == "53: Transportation and Material Movers"

replace pre911_group = "Management" if pre9110ccup == "11: Management Occupations"

replace pre911_group = "Unemployed/Retired" if inlist(pre9110ccup, "UNEMPLOYED", "RETIRED")

replace pre911_group = "Not Reported" if pre9110ccup == "UNKNOWN"

replace pre911_group = "Other" if missing(pre911_group)

tab pre911_group


save 
