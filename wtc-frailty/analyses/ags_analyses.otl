H="get WTC-certified condition"

* Step 1: Summarize certifications by comment
import delimited "\\mssm2\mssm2$\wangy63\Personal\DesktopFiles\DC_FK Frailty assessment\FK250117 Frailty\FK250117_certifications.csv",clear 

contract comment patient_id, freq(freq)
bysort comment (patient_id): keep if _n == 1
collapse (count) participants = patient_id, by(comment)
list, sepby(comment)

* Step 2: Import ICD9/10 crosswalk Excel file
import excel using "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Ahmad\All_Related_180403_ICD9to10.xlsx",firstrow clear 
rename Code code 
save "\\mssm2\mssm2$\wangy63\Personal\DesktopFiles\DC_FK Frailty assessment\Yihan\ags analyses\All_Related_180403_ICD9to10.dta",replace 

* Step 3: Prepare main certification dataset
import delimited "\\mssm2\mssm2$\wangy63\Personal\DesktopFiles\DC_FK Frailty assessment\FK250117 Frailty\FK250117_certifications.csv",clear 
sort patient_id
save "\\mssm2\mssm2$\wangy63\Personal\DesktopFiles\DC_FK Frailty assessment\FK250117 Frailty\Frailty_certs.dta", replace


* Step 4: Merge with ICD9/10 code crosswalk
use "\\mssm2\mssm2$\wangy63\Personal\DesktopFiles\DC_FK Frailty assessment\FK250117 Frailty\Frailty_certs.dta", clear
rename related_condition code
sort code

merge m:1 code using "\\mssm2\mssm2$\wangy63\Personal\DesktopFiles\DC_FK Frailty assessment\Yihan\ags analyses\All_Related_180403_ICD9to10.dta", ///
    keepusing(Code_Description Care_Suite_Detail) keep(master match)
rename code related_condition  // restore name if needed

sort patient_id start_date related_condition associated_condition
save "\\mssm2\mssm2$\wangy63\Personal\DesktopFiles\DC_FK Frailty assessment\FK250117 Frailty\Frailty_certs1.dta", replace






