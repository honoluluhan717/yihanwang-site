H="add n390"
import delimited "\\mssm2\mssm2$\wangy63\Personal\DesktopFiles\n390_ids.csv", clear varnames(nonames)
rename v1 patient_id

gen prefix = substr(patient_id,1,strpos(patient_id,"_")-1)
gen idnum  = real(substr(patient_id,strpos(patient_id,"_")+1,.))

tempfile main pilot

preserve
keep if prefix=="WTCII"
keep idnum
rename idnum record_id_main
duplicates drop
save `main'
restore

preserve
keep if prefix=="WTCI"
keep idnum
rename idnum record_id_pilot
duplicates drop
save `pilot'
restore

use "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\all done 0919.dta", clear

gen in_n390 = 0

drop _merge
merge m:1 record_id_main using `main'
replace in_n390 = 1 if _merge==3
drop _merge

merge m:1 record_id_pilot using `pilot'
replace in_n390 = 1 if _merge==3 | in_n390==1
drop _merge

keep if in_n390==1

gen moca_total_final = .
replace moca_total_final = moca_total_b   if jhu_source=="baseline" & moca_total_b   <.
replace moca_total_final = moca_total_fu1 if jhu_source=="fu1"      & moca_total_fu1 <.
replace moca_total_final = moca_total_fu2 if jhu_source=="fu2"      & moca_total_fu2 <.
replace moca_total_final = moca_total   if jhu_source=="pilot"    & moca_total   <.
tab moca_total_final

summarize moca_total_final if moca_total_final < 26

save "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\all done 0919_with390flag.dta", replace


