//subgroup 

use "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\all done 0919.dta",clear 

gen bmi_Group_combined = bmi_Group_final
replace bmi_Group_combined = "Normal/Underweight" if inlist(bmi_Group_final, "Normal", "Underweight")
drop bmi_Group_final
rename bmi_Group_combined bmi_Group_final

gen exposure_combined = exposure_final
replace exposure_combined = "High/Very High" if inlist(exposure_final, "High", "Very High")
drop exposure_final
rename exposure_combined exposure_final

gen education_recode = education_final

replace education_recode = "<=High school" if inlist(education_final, "<HS Grad", "HS Grad")
replace education_recode = "Some college"  if education_final == "<BA/BS"
replace education_recode = "College"       if inlist(education_final, "BA/BS", "Grad Sch")
replace education_recode = ""               if education_final == "Unknown"

drop education_final
rename education_recode education_final

replace race_final = "" if race_final == "Unknown"

keep if !missing(jhu_source)

gen any_er_hos_final = .
replace any_er_hos_final = 1 if hospital_stay_final == 1 | er_stay_final == 1
replace any_er_hos_final = 0 if hospital_stay_final == 0 & er_stay_final == 0

tab any_er_hos_final, m


gen jhu_binary_final = .
replace jhu_binary_final = 0 if jhu_cat_final == 0
replace jhu_binary_final = 1 if inlist(jhu_cat_final, 1, 2)

label define jhu_bin 0 "Not frail" 1 "Pre-frail/Frail"
label values jhu_binary_final jhu_bin
tab jhu_binary_final,m

gen has_any_mental_condition_final = has_certPTSD_final == 1 | has_certANX_final == 1 | has_certDEP_final == 1 | has_certSA_final
rename has_any_mental_condition_final has_any_ment_cond

gen has_any_BUT_mentalhealth = has_any_cert_final == 1 & has_any_ment_cond == 0



foreach v in gender_final race_final education_final bmi_Group_final ///
            smoking_status_final exposure_final {
    encode `v', gen(`v'_num)
    drop `v'
    rename `v'_num `v'
}

fvset base 3 exposure_final
fvset base 3 smoking_status_final
fvset base 4 race_final
fvset base 2 gender_final


//imputation 
mi set mlong

mi register regular any_er_hos_final gender_final has_any_ment_cond has_any_BUT_mentalhealth has_certURD_final has_certPTSD_final has_certCancer_final has_certGERD_final
mi register imputed age_at_jhu_int race_final education_final bmi_Group_final ///
                    smoking_status_final exposure_final 

mi impute chained ///
    (regress) age_at_jhu_int ///
    (mlogit, augment) race_final smoking_status_final ///
    (ologit) education_final bmi_Group_final exposure_final ///
    = i.gender_final i.any_er_hos_final i.has_any_ment_cond i.has_any_BUT_mentalhealth i.has_certURD_final i.has_certPTSD_final i.has_certCancer_final i.has_certGERD_final, ///
    add(20) rseed(12345) force

mi estimate, or: logistic any_er_hos_final i.gender_final age_at_jhu_int i.race_final i.education_final i.bmi_Group_final i.smoking_status_final i.exposure_final i.jhu_binary_final i.has_certCancer_final

mi estimate, or: logistic any_er_hos_final i.gender_final age_at_jhu_int i.race_final i.education_final i.bmi_Group_final i.smoking_status_final i.exposure_final i.jhu_binary_final i.has_certGERD_final

mi estimate, or: logistic any_er_hos_final i.gender_final age_at_jhu_int i.race_final i.education_final i.bmi_Group_final i.smoking_status_final i.exposure_final i.jhu_binary_final i.has_certPTSD_final

mi estimate, or: logistic any_er_hos_final i.gender_final age_at_jhu_int i.race_final i.education_final i.bmi_Group_final i.smoking_status_final i.exposure_final i.jhu_binary_final i.has_certURD_final

mi estimate, or: logistic any_er_hos_final i.gender_final age_at_jhu_int i.race_final i.education_final i.bmi_Group_final i.smoking_status_final i.exposure_final i.jhu_binary_final i.has_any_ment_cond

mi estimate, or: logistic any_er_hos_final i.gender_final age_at_jhu_int i.race_final i.education_final i.bmi_Group_final i.smoking_status_final i.exposure_final i.jhu_binary_final i.has_any_BUT_mentalhealth


//event rates 

foreach v in has_any_ment_cond has_any_BUT_mentalhealth has_any_cert_final has_certURD_final ///
has_certSRC_final has_certSP_final has_certSA_final has_certPTSD_final ///
has_certOAD_final has_certILD_final has_certGERD_final has_certEXT_final ///
has_certDEP_final has_certCancer_final has_certANX_final {

    di "-----------------------------"
    di "`v'"
    tab any_er_hos_final `v', row
}

foreach cert in Cancer GERD PTSD URD {
    mi estimate, or: logistic any_er_hos_final ///
        i.gender_final age_at_jhu_int ///
        i.race_final i.education_final i.bmi_Group_final ///
        i.smoking_status_final i.exposure_final ///
        i.has_any_cert_final i.jhu_binary_final ///
        i.has_cert`cert'_final
}

mi estimate, or: logistic any_er_hos_final ///
    i.gender_final age_at_jhu_int ///
    i.race_final i.education_final i.bmi_Group_final ///
    i.smoking_status_final i.exposure_final ///
    i.has_any_cert_final i.jhu_binary_final ///
    i.has_any_ment_cond


