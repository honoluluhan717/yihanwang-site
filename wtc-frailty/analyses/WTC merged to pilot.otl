foreach v in jhu_cat_final frail_cat_final gender_final age_group ///
            race_final smoking_status_final bmi_Group_final ///
            soc_4_categories_final education_final exposure_final ///
            adl_cat_final callahan_cat_final moca_cat_final ///
            fesi_cat_final fall_risk_final ///
            er_stay_6month_final er_stay_final ///
            hospital_stay_6month_final hospital_stay_final {
    
    di "======================================"
    di "Variable: `v' by any_er_hos_final"
