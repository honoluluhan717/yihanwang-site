*================================================
* Step 3: Clean height and weight (wide, v1–v20)
*================================================

* 0) Ensure numeric types (safe even if already numeric)
capture destring height_in*, replace ignore("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ ,:()$")
capture destring weight_lb*,  replace ignore("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ ,:()$")
capture destring bmi_lbin*,   replace ignore("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ ,:()$")

* 1) Preserve originals before cleaning
forvalues k = 1/20 {
    capture confirm variable height_in`k'
    if !_rc gen height_orig`k' = height_in`k'
    capture confirm variable weight_lb`k'
    if !_rc gen weight_orig`k' = weight_lb`k'
}

* 2) Clean height & weight per visit
forvalues k = 1/20 {
    * height
    capture confirm variable height_in`k'
    if !_rc {
        replace height_in`k' = . if height_in`k' == 999 | height_in`k' <= 0
        replace height_in`k' = . if height_in`k' <= 53 | height_in`k' >= 84
    }
    * weight
    capture confirm variable weight_lb`k'
    if !_rc {
        replace weight_lb`k' = . if weight_lb`k' == 999 | weight_lb`k' <= 0
        replace weight_lb`k' = round(weight_lb`k', 0.1) if !missing(weight_lb`k')
        replace weight_lb`k' = . if weight_lb`k' <= 75 | weight_lb`k' >= 600
    }
}

*================================================
* Step 4: Per-visit BMI (kg/m^2), rounded, and *_p categories
*================================================
forvalues k = 1/20 {
    capture confirm variable height_in`k'
    if _rc continue

    * Standardize BMI numeric holder: bmi_lbin# -> bmi_kgm#
    capture confirm variable bmi_lbin`k'
    if !_rc {
        rename bmi_lbin`k' bmi_kgm`k'
        capture destring bmi_kgm`k', replace ignore("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ ,:()$")
    }
    else gen double bmi_kgm`k' = .

    * Helpers from cleaned and original values
    gen double kg`k'      = . 
    gen double m`k'       = . 
    gen double orig_kg`k' = . 
    gen double orig_m`k'  = . 

    capture replace kg`k'      = weight_lb`k'   / 2.2046226 if !missing(weight_lb`k')
    capture replace m`k'       = height_in`k'   * 0.0254    if !missing(height_in`k')
    capture replace orig_kg`k' = weight_orig`k' / 2.2046226 if !missing(weight_orig`k')
    capture replace orig_m`k'  = height_orig`k' * 0.0254    if !missing(height_orig`k')

    * Primary BMI using cleaned values
    replace bmi_kgm`k' = kg`k' / (m`k'^2) if !missing(kg`k', m`k')

    * Fallbacks using originals when one or both cleaned inputs missing
    replace bmi_kgm`k' = orig_kg`k' / (m`k'^2)      if missing(weight_lb`k') & !missing(m`k')
    replace bmi_kgm`k' = kg`k'      / (orig_m`k'^2) if !missing(kg`k') & missing(m`k')
    replace bmi_kgm`k' = orig_kg`k' / (orig_m`k'^2) if missing(kg`k', m`k') & !missing(orig_kg`k', orig_m`k')

    * Rounded BMI
    gen double bmi_kgmR`k' = round(bmi_kgm`k', 0.1) if !missing(bmi_kgm`k')

    * Drop helpers
    drop kg`k' m`k' orig_kg`k' orig_m`k'

    * CDC BMI categories — create directly with "_p" suffix
    gen str12 bmi_Group`k'_p = ""
    replace bmi_Group`k'_p = "Underweight"  if !missing(bmi_kgm`k') & bmi_kgm`k' < 18.5
    replace bmi_Group`k'_p = "Normal"       if !missing(bmi_kgm`k') & bmi_kgm`k' >= 18.5 & bmi_kgm`k' < 25
    replace bmi_Group`k'_p = "Overweight"   if !missing(bmi_kgm`k') & bmi_kgm`k' >= 25   & bmi_kgm`k' < 30
    replace bmi_Group`k'_p = "Obese"        if !missing(bmi_kgm`k') & bmi_kgm`k' >= 30
    replace bmi_Group`k'_p = "" if missing(bmi_kgm`k')
}

rename ptid record_id_pilot

save "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\bmi_pilotdata.dta", replace


