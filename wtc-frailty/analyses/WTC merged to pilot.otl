H="---"


H="WTC certified condition old"


H="WTC certified condition new"


H="---"


H="clean redcap pilot data "
import excel "\\mssm2\mssm2$\wangy63\Personal\DesktopFiles\WTC Pilot data_7.9.2025 raw.xlsx",firstrow clear

rename participant_id record_id_pilot

//jhu score 
gen jhu_cat_p=.
replace jhu_cat_p=0 if jhu_score==0 
replace jhu_cat_p=1 if jhu_score==1 | jhu_score==2 
replace jhu_cat_p=2 if jhu_score==3 | jhu_score==4 | jhu_score==5

label define jhu_cat 0 "Not Frail/Robust Health" 1 "Pre-Frail" 2 "Frail"
label values jhu_cat_p jhu_cat
tab jhu_cat_p,m

//frail scales 
gen frail_cat_p=.
replace frail_cat_p=0 if frail_total==0
replace frail_cat_p=1 if frail_total==1 | frail_total==2
replace frail_cat_p=2 if frail_total>=3
tab frail_cat_p

label define frail_cat 0 "Not Frail" 1 "Pre-Frial" 2 "Frail"
label values frail_cat_p frail_cat
tab frail_cat_p,m

//ADL scale 
egen adl_score = rowtotal(adl_phone adl_move adl_shop adl_meal adl_house adl_med adl_money adl_wash adl_dress adl_eat adl_walk adl_clean)
egen _nvalid   = rownonmiss(adl_phone adl_move adl_shop adl_meal adl_house adl_med adl_money adl_wash adl_dress adl_eat adl_walk adl_clean)
replace adl_score = . if _nvalid==0
drop _nvalid

gen adl_cat_p=.
replace adl_cat_p=0 if adl_score<24 & adl_score>=0
replace adl_cat_p=1 if adl_score>=24
replace adl_cat_p=2 if adl_score<0
label define adl_cat 0 "Not fully independent" 1 "Independent" 2 "Unknown"
label values adl_cat_p adl_cat
tab adl_cat_p,m nol

//Callahan scale 
egen callahan_score_p=rowtotal(cog_year cog_month cog_day cog_obj_apple cog_obj_table cog_obj_penny)
tab callahan_score_p,m

gen callahan_cat_p=.
replace callahan_cat_p=0 if callahan_score_p==0 | callahan_score_p==1 | callahan_score_p==2 | callahan_score_p==3
replace callahan_cat_p=1 if callahan_score_p==4 | callahan_score_p==5 | callahan_score_p==6
label define callahan_cat_p 0 "Impairment likely" 1 "Not impaired"
label values callahan_cat_p callahan_cat_p
tab callahan_cat_p,m
tab callahan_cat_p,m nol 

//MOCA
gen moca_cat_p=.
replace moca_cat_p=0 if moca_total>=26 & moca_total<=31
replace moca_cat_p=1 if moca_total>=18 & moca_total<=25
replace moca_cat_p=2 if moca_total>=10 & moca_total<=17
replace moca_cat_p=3 if moca_total>=0 & moca_total<=9
label define moca_cat 0 "Normal" 1 "Mild cognitive impairment" 2 "Moderate cognitive impairment" 3 "Severe cognitive impairment"
label values moca_cat_p moca_cat
tab moca_cat_p,m
tab moca_cat_p,m nol 

//FESI scale 
gen fesi_cat_p=.
replace fesi_cat_p=0 if fesi_total>=16 & fesi_total<=19
replace fesi_cat_p=1 if fesi_total>=20 & fesi_total<=27
replace fesi_cat_p=2 if fesi_total>=28 & fesi_total<64 
label define fesi_cat 0 "Low Concern" 1 "Moderate Concern" 2 "High Concern"
label values fesi_cat_p fesi_cat
tab fesi_cat_p,m
tab fesi_cat_p,m nol

//fall assessment score 
gen fall_risk_p = .
replace fall_risk_p = 1 if falls_afraid == 1 | falls_year == 1
replace fall_risk_p = 0 if falls_afraid == 0 & falls_year == 0
replace fall_risk_p=. if fall_risk_p<0
tab fall_risk_p,m

rename falls_year falls_year_p
rename falls_year_mult falls_year_mult_p

//ER visits 
rename er_stay er_stay_p
rename er_stay_6month er_stay_6month_p

//hospital stay 
rename hospital_stay hospital_stay_p
rename hospital_stay_6month hospital_stay_6month_p

save "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\redcap0729_pilot.dta",replace


H="---"


H="only check the pilot data"
import excel "\\mssm2\mssm2$\wangy63\Personal\DesktopFiles\WTC Pilot data_7.9.2025 raw.xlsx", sheet("WTC Pilot data_7.9.2025 raw") firstrow

* ADL item list
local adl_items adl_clean adl_dress adl_eat adl_house adl_meal adl_med ///
                adl_money adl_move adl_phone adl_shop adl_walk adl_wash

* 1) Recode -98/-99/-95 to missing
foreach v of local adl_items {
    replace `v' = . if inlist(`v', -98, -99, -95)
}

* 2) Sum available items (skips missing)
capture drop adl_score
egen adl_score = rowtotal(`adl_items')
label var adl_score "Total ADL score"

* 3) Categorize
capture drop adl_cat
label define adl_cat 0 "Not fully independent" 1 "Independent" 2 "Unknown"

gen adl_cat = .
replace adl_cat = 0 if adl_score < 24 & adl_score >= 0
replace adl_cat = 1 if adl_score >= 24
replace adl_cat = 2 if missing(adl_score)

label values adl_cat adl_cat
label var adl_cat "ADL category"

tab adl_cat,m

gen falls_risk = .
replace falls_risk = 1 if falls_afraid == 1 | falls_year == 1
replace falls_risk = 0 if falls_afraid == 0 & falls_year == 0
replace falls_risk=. if falls_risk<0

tab falls_risk,missing

H="---"


H="merge to original data"

