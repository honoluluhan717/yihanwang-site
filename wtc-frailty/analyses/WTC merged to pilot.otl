foreach var in has_certANX_final has_certCancer_final has_certDEP_final has_certEXT_final has_certGERD_final has_certILD_final has_certOAD_final has_certPTSD_final has_certSA_final has_certSP_final has_certSRC_final has_certURD_final has_any_cert_final has_any_mental_condition {
	tab `var'
}

//regression outcomes - ER or hospital stay 
gen er_hos_final = 0
replace er_hos_final = 1 if er_stay_final == 1 | hospital_stay_final == 1

encode gender_final, gen(_gender_tmp)
drop gender_final
rename _gender_tmp gender_final

egen counts_certification = rowtotal(has_certANX_final has_certCancer_final has_certDEP_final has_certEXT_final has_certGERD_final has_certILD_final has_certOAD_final has_certPTSD_final has_certSA_final has_certSP_final has_certSRC_final has_certURD_final)

replace education2_final = . if education2_final == 3


*----------------------------
* Model 1) Cancer certification
*----------------------------
logistic er_hos_final i.has_certCancer_final ///
    i.jhu_frail_binary age_at_jhu_int ///
    i.gender_final i.race3_final i.education2_final ///
    i.adl_cat_final i.moca2_final i.falls_year_final

*----------------------------
* Model 2) GERD certification
*----------------------------
logistic er_hos_final i.has_certGERD_final ///
    i.jhu_frail_binary age_at_jhu_int ///
    i.gender_final i.race3_final i.education2_final ///
    i.adl_cat_final i.moca2_final i.falls_year_final

*----------------------------
* Model 3) OAD certification
*----------------------------
logistic er_hos_final i.has_certOAD_final ///
    i.jhu_frail_binary age_at_jhu_int ///
    i.gender_final i.race3_final i.education2_final ///
    i.adl_cat_final i.moca2_final i.falls_year_final

*----------------------------
* Model 4) URD certification
*----------------------------
logistic er_hos_final i.has_certURD_final ///
    i.jhu_frail_binary age_at_jhu_int ///
    i.gender_final i.race3_final i.education2_final ///
    i.adl_cat_final i.moca2_final i.falls_year_final

*----------------------------
* Model 5) Any certification
*----------------------------
logistic er_hos_final i.has_any_cert_final ///
    i.jhu_frail_binary age_at_jhu_int ///
    i.gender_final i.race3_final i.education2_final ///
    i.adl_cat_final i.moca2_final i.falls_year_final

*----------------------------
* Model 6) Any mental health certification
*----------------------------
logistic er_hos_final i.has_any_mental_condition ///
    i.jhu_frail_binary age_at_jhu_int ///
    i.gender_final i.race3_final i.education2_final ///
    i.adl_cat_final i.moca2_final i.falls_year_final

*----------------------------
* Model 7) Count of certifications
*----------------------------
logistic er_hos_final counts_certification ///
    i.jhu_frail_binary age_at_jhu_int ///
    i.gender_final i.race3_final i.education2_final ///
    i.adl_cat_final i.moca2_final i.falls_year_final


