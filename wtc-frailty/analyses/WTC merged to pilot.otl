    capture confirm string variable `v'
    if !_rc {
        encode `v', gen(`v'_n)
        drop `v'
        rename `v'_n `v'
    }
}

fvset base 3 exposure_final
fvset base 3 smoking_status_final
fvset base 4 race_final
fvset base 2 gender_final
set seed 12345

mi set mlong

mi register regular gender_final jhu_binary_final soc_4_categories_final
mi register imputed age_at_jhu_int race_final education_final bmi_Group_final ///
                    smoking_status_final exposure_final 

mi impute chained ///
    (regress) age_at_jhu_int ///
    (mlogit, augment) race_final smoking_status_final ///
    (ologit) education_final bmi_Group_final exposure_final ///
    = i.gender_final i.jhu_binary_final has_any_cert_final soc_4_categories_final, add(20) rseed(12345) force

	



mi estimate, or: logistic jhu_binary_final i.gender_final age_at_jhu_int ///
    i.race_final i.education_final i.bmi_Group_final ///
    i.smoking_status_final i.exposure_final i.has_any_cert_final i.adl_cat_final ///
	i.moca_cat_final i.fall_risk_final i.soc_4_categories_final

estimates store m1

coefplot m1, eform drop(_cons) ///
    xscale(log) ///
    xline(1, lpattern(dash) lcolor(gs8)) ///
    ciopts(recast(rcap) lwidth(medthin)) ///
    msymbol(D) msize(medium) ///
    xlabel(0.25 0.5 1 2 4 8, grid format(%3.2f)) ///
    xtitle("Adjusted Odds Ratio (95% CI)") ///
    title("Factors Associated with Pre-Frailty/Frailty") ///
    yscale(reverse) ///
    coeflabels( ///
        1.gender_final = "Sex – Female" ///
        age_at_jhu_int = "Age" ///
        1.race_final = "Race – Asian" ///
        2.race_final = "Race – Black" ///
        3.race_final = "Race – Other" ///
        2.education_final = "Education – College" ///
        3.education_final = "Education – Some college" ///
        2.bmi_Group_final = "BMI – Obese" ///
        3.bmi_Group_final = "BMI – Overweight" ///
        1.smoking_status_final = "Smoking – Current" ///
        2.smoking_status_final = "Smoking – Former" ///
        1.exposure_final = "Exposure – High/Very High" ///
        2.exposure_final = "Exposure – Intermediate" ///
        1.has_any_cert_final = "Any certification" ///
        1.adl_cat_final = "ADL category 1" ///
        2.adl_cat_final = "ADL category 2" ///
        1.moca_cat_final = "MoCA category 1" ///
        2.moca_cat_final = "MoCA category 2" ///
        1.fall_risk_final = "Fall risk" ///
        1.soc_4_categories_final = "Occupation – Protective" ///
        2.soc_4_categories_final = "Occupation – SOC37&49" ///
        3.soc_4_categories_final = "Occupation – Residual" ///
    )



translate "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\output\output 021326.smcl" "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\output\output 021326.pdf"

log close 
