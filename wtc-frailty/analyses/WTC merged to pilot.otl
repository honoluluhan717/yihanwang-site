H="two frail outcomes from redcap"
import delimited "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\initial data\WTCII_DATA_2025-07-01_1432.csv",clear

drop if record_id=="88"
replace record_id="16" if record_id=="16 (withdrawn)"
replace record_id="50" if record_id=="50 (withdrawn)"
replace record_id="86" if record_id=="86 (withdrawn)"
replace record_id="88" if record_id=="88 (Withdrawn)"

//fill those missing Callahan score on Redcap 
**#88; #1175; #1577; #4855 has actual missing scores 
replace callahan_score=6 if record_id=="3"
replace callahan_score=6 if record_id=="26"
replace callahan_score=6 if record_id=="28"
replace callahan_score=6 if record_id=="36"
replace callahan_score=6 if record_id=="45"
replace callahan_score=6 if record_id=="46"


//create JHU frail flag & frail scale flag 
**0 = 'Not Frail/Robust Health'
**1-2 = 'Pre-Frail'
**3-5 = 'Frail'
**. = 'Missing' ;

//jhu categorical variable 
gen jhu_cat=.
replace jhu_cat=0 if jhu_score==0 
replace jhu_cat=1 if jhu_score==1 | jhu_score==2 
replace jhu_cat=2 if jhu_score==3 | jhu_score==4 | jhu_score==5

label define jhu_cat 0 "Not Frail/Robust Health" 1 "Pre-Frail" 2 "Frail"
label values jhu_cat jhu_cat
tab jhu_cat,m

//jhu binary flag 
gen jhu_frail_flag=.
replace jhu_frail_flag=0 if jhu_cat==0
replace jhu_frail_flag=1 if jhu_cat==1 | jhu_cat==2 
label define jhu_frail_flag 0 "Not Frail/Robust Health" 1 "Pre-Frail/Frail"
label values jhu_frail_flag jhu_frail_flag 
tab jhu_frail_flag


//Frail phenotype categorical variable 
gen frail_cat=.
replace frail_cat=0 if frail_total==0
replace frail_cat=1 if frail_total==1 | frail_total==2
replace frail_cat=2 if frail_total>=3
tab frail_cat
label define frail_cat 0 "Not Frail" 1 "Pre-Frial" 2 "Frail"
label values frail_cat frail_cat
tab frail_cat,m

//Frail phenotype flag 
gen frail_flag=.
replace frail_flag=0 if frail_cat==0 
replace frail_flag=1 if frail_cat==1 | frail_cat==2
label define frail_flag 0 "Not Frail" 1 "Pre-Frail/Frail"
label values frail_flag frail_flag
tab frail_flag,m


//Other geriatric assessments 

//FESI score 
gen fesi_cat=.
replace fesi_cat=0 if fesi_total>=16 & fesi_total<=19
replace fesi_cat=1 if fesi_total>=20 & fesi_total<=27
replace fesi_cat=2 if fesi_total>=28 & fesi_total<64 
label define fesi_cat 0 "Low Concern" 1 "Moderate Concern" 2 "High Concern"
label values fesi_cat fesi_cat
tab fesi_cat,m

//MOCA score 
gen moca_catags=.
replace moca_catags=0 if moca_total>=26 & moca_total<=31
replace moca_catags=1 if moca_total>=18 & moca_total<=25
replace moca_catags=2 if moca_total>=10 & moca_total<=17
replace moca_catags=3 if moca_total>=0 & moca_total<=9
label define moca_catags 0 "Normal" 1 "Mild cognitive impairment" 2 "Moderate cognitive impairment" 3 "Severe cognitive impairment"
label values moca_catags moca_catags
tab moca_catags,m

//ADL category 
gen adl_cat=.
replace adl_cat=0 if adl_score<24
replace adl_cat=1 if adl_score>=24
replace adl_cat=2 if adl_score<0
label define adl_cat 0 "Not fully independent" 1 "Independent" 2 "Unknown"
label values adl_cat adl_cat
tab adl_cat

//Callahan Score 
gen callahan_cat=.
replace callahan_cat=0 if callahan_score==0 | callahan_score==1 | callahan_score==2 | callahan_score==3
replace callahan_cat=1 if callahan_score==4 | callahan_score==5 | callahan_score==6
label define callahan_cat 0 "Impairment likely" 1 "Not impaired"
label values callahan_cat callahan_cat
tab callahan_cat,m

//reshape the data from long to wide using necessary geriatric variables 

* 1) Make short wave suffixes for wide names
gen str6 wave = "_b"    if redcap_event_name=="baseline_arm_1"
replace  wave = "_fu1"  if redcap_event_name=="first_follow_up_arm_1"
replace  wave = "_fu2"  if redcap_event_name=="second_follow_up_arm_1"

* 2) Ensure one row per id×wave before reshaping (optional but recommended)
isid record_id wave   // will error if duplicates exist

* 3) Collect all stubs = everything except ID and J
ds
local all `r(varlist)'
local falls_year falls_year_mult callahan_cat adl_cat moca_catags fesi_cat frail_flag frail_cat jhu_frail_flag jhu_cat hospital_stay hospital_stay_6month er_stay er_stay_6month adl_phone adl_move adl_shop adl_meal adl_house adl_med adl_money adl_wash adl_dress adl_eat adl_walk adl_clean adl_score fesi_cleaning fesi_dressed fesi_meals fesi_bathing fesi_shopping fesi_sitting fesi_stairs fesi_walking fesi_reaching fesi_phone fesi_slippery fesi_visit fesi_crowds fesi_uneven fesi_slope fesi_social_event fesi_total falls falls_count falls_afraid  cog_word cog_year cog_month cog_day cog_obj_apple cog_obj_table cog_obj_penny callahan_score moca_total weight_current weight_past weight_change weight_height fall_risk : list all - record_id - redcap_event_name - wave

keep falls_year falls_year_mult callahan_cat adl_cat moca_catags fesi_cat frail_flag frail_cat jhu_frail_flag jhu_cat hospital_stay hospital_stay_6month er_stay er_stay_6month adl_phone adl_move adl_shop adl_meal adl_house adl_med adl_money adl_wash adl_dress adl_eat adl_walk adl_clean adl_score fesi_cleaning fesi_dressed fesi_meals fesi_bathing fesi_shopping fesi_sitting fesi_stairs fesi_walking fesi_reaching fesi_phone fesi_slippery fesi_visit fesi_crowds fesi_uneven fesi_slope fesi_social_event fesi_total falls falls_count falls_afraid cog_word cog_year cog_month cog_day cog_obj_apple cog_obj_table cog_obj_penny callahan_score moca_total weight_current weight_past weight_change weight_height fall_risk record_id wave 

rename record_id record_id_main 

* 4) Reshape ALL variables to wide (short suffixes avoid name-length issues)
reshape wide falls_year falls_year_mult callahan_cat adl_cat moca_catags fesi_cat frail_flag frail_cat jhu_frail_flag jhu_cat hospital_stay hospital_stay_6month er_stay er_stay_6month adl_phone adl_move adl_shop adl_meal adl_house adl_med adl_money adl_wash adl_dress adl_eat adl_walk adl_clean adl_score fesi_cleaning fesi_dressed fesi_meals fesi_bathing fesi_shopping fesi_sitting fesi_stairs fesi_walking fesi_reaching fesi_phone fesi_slippery fesi_visit fesi_crowds fesi_uneven fesi_slope fesi_social_event fesi_total falls falls_count cog_word cog_year cog_month cog_day cog_obj_apple cog_obj_table cog_obj_penny callahan_score moca_total weight_current weight_past weight_change weight_height fall_risk falls_afraid, i(record_id) j(wave) string

save "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\initial data\redcap0701_cleaned.dta",replace


