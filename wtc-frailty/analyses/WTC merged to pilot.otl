use "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\all done 0919.dta",clear 

keep if !missing(jhu_source)

gen byte jhu_2cat_final = .
replace jhu_2cat_final = 0 if jhu_cat_final == 0   // Not Frail
replace jhu_2cat_final = 1 if inlist(jhu_cat_final, 1, 2)   // Pre-Frail or Frail

label define jhu2 0 "Not Frail" 1 "Pre-Frail or Frail"
label values jhu_2cat_final jhu2

* Check
tab jhu_cat_final jhu_2cat_final, m

* Combine Normal + Underweight into one category from the ORIGINAL string var
gen byte bmi_Group_final_combined = .
replace bmi_Group_final_combined = 0 if inlist(lower(strtrim(bmi_Group_final)), "normal", "underweight")
replace bmi_Group_final_combined = 1 if lower(strtrim(bmi_Group_final)) == "obese"
replace bmi_Group_final_combined = 2 if lower(strtrim(bmi_Group_final)) == "overweight"

label define bmi_comb 0 "Normal+Underweight" 1 "Obese" 2 "Overweight", replace
label values bmi_Group_final_combined bmi_comb

sum jhu_2cat_final gender_final age_group race_final smoking_status_final bmi_Group_final_combined soc_4_categories_final education_final exposure_final has_*_final adl_cat_final callahan_cat_final moca_cat_final fesi_cat_final fall_risk_final er_stay_final hospital_stay_final

summarize age_at_jhu, meanonly
replace age_at_jhu = r(mean) if missing(age_at_jhu)

gen str20 education_regrped_final = ""
replace education_regrped_final = "Some College"          if education_final == "<BA/BS"
replace education_regrped_final = "Less than high school" if education_final == "<HS Grad"
replace education_regrped_final = "College"               if inlist(education_final, "BA/BS", "Grad Sch")
replace education_regrped_final = "High School"           if education_final == "HS Grad"
replace education_regrped_final = "Not Reported"          if education_final == "Unknown"
tab education_regrped_final 

//multiple imputation 

* 1. Set data for MI
mi set wide

encode exposure_final, gen(exposure_final_num)
encode smoking_status_final, gen(smoking_status_final_num)
encode gender_final, gen(gender_final_num)
encode race_final, gen(race_final_num)
encode soc_4_categories_final, gen(soc_4_categories_final_num)
encode education_regrped_final, gen(education_regrped_final_num)

* Overwrite original: 1==High School, 2=Some College, 3=College (Not Reported -> missing)
replace education_regrped_final_num = . if education_regrped_final_num == 4
recode  education_regrped_final_num (3 2=1) (5=2) (1=3)
label define edu3_lbl 1 "= High School" 2 "Some College" 3 "College", replace
label values education_regrped_final_num edu3_lbl
tab education_regrped_final_num,m

recode exposure_final_num (3 = 1) (2 = 2) (1 4 = 3)
label define exposure_lbl 1 "Low" 2 "Intermediate" 3 "High + Very High", replace
label values exposure_final_num exposure_lbl
tab exposure_final_num
tab exposure_final_num, nol

replace adl_cat_final = . if adl_cat_final == 2
label define adl_lbl 0 "Not fully independent" 1 "Independent", replace
label values adl_cat_final adl_lbl
tab adl_cat_final, missing

label define moca_lbl 0 "Normal" 1 "Mild" 2 "Moderate/Severe", replace
label values moca_cat_final moca_lbl
tab moca_cat_final

replace race_final_num = . if race_final_num == 4

* 2. Register vars with missing
mi register imputed moca_cat_final exposure_final_num smoking_status_final_num bmi_Group_final_combined education_regrped_final_num adl_cat_final race_final_num 
mi register regular jhu_2cat_final gender_final_num age_at_jhu soc_4_categories_final_num fall_risk_final has_certCancer_final has_certDEP_final has_certGERD_final has_certOAD_final has_certPTSD_final has_certSP_final has_certURD_final 

mi impute chained ///
    (mlogit,augment) smoking_status_final_num race_final_num ///
	(ologit,augment) adl_cat_final moca_cat_final bmi_Group_final_combined exposure_final_num education_regrped_final_num ///
    = jhu_2cat_final gender_final_num age_at_jhu soc_4_categories_final_num ///
      fall_risk_final has_certCancer_final has_certDEP_final has_certGERD_final ///
      has_certOAD_final has_certPTSD_final has_certSP_final has_certURD_final, add(20) rseed(12345) force
	  
* Set reference groups 
mi fvset base 2 bmi_Group_final_combined
mi fvset base 2 exposure_final_num
mi fvset base 5 race_final_num
mi fvset base 3 education_regrped_final_num
mi fvset base 3 smoking_status_final_num
mi fvset base 2 soc_4_categories_final_num
mi fvset base 1 adl_cat_final
mi fvset base 1 moca_cat_final
mi fvset base 0 fall_risk_final
  
* Logistic regression model1 
mi estimate, or esampvaryok: logistic jhu_2cat_final c.age_at_jhu i.race_final_num i.education_regrped_final_num i.smoking_status_final_num i.bmi_Group_final_combined

* Logistic regression model2 
mi estimate, or esampvaryok: logistic jhu_2cat_final c.age_at_jhu i.race_final_num i.education_regrped_final_num i.smoking_status_final_num i.bmi_Group_final_combined i.soc_4_categories_final_num i.exposure_final_num i.has_certCancer_final i.has_certDEP_final i.has_certGERD_final i.has_certOAD_final i.has_certPTSD_final i.has_certSP_final i.has_certURD_final
	
* Logistic regression model3  
mi estimate, or esampvaryok: logistic jhu_2cat_final c.age_at_jhu i.race_final_num i.education_regrped_final_num i.smoking_status_final_num i.bmi_Group_final_combined i.soc_4_categories_final_num i.exposure_final_num i.has_certCancer_final i.has_certDEP_final i.has_certGERD_final i.has_certOAD_final i.has_certPTSD_final i.has_certSP_final i.has_certURD_final i.adl_cat_final i.moca_cat_final i.fall_risk_final

	
