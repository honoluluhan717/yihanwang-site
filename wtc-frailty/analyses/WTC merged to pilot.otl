* Step 2: Merge with crosswalk file (must have first_name and last_name in both)
import delimited "\\mssm2\mssm2$\wangy63\Personal\DesktopFiles\DC_FK Frailty assessment\FK250117 Frailty\Fk250117_visits_marital_work.csv", clear
keep patient_id visit_number visit_date
reshape wide visit_date, i(patient_id) j(visit_number)
merge 1:m patient_id using "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\PE.dta"

drop _merge
save "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\PEx.dta", replace

* Step 3: Clean height and weight
*==============================
* Wide data BMI pipeline (visits 1-20)
*==============================

* 0) Ensure numeric types (safe even if already numeric)
capture destring height_in*, replace ignore("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ ,:()$")
capture destring weight_lb*,  replace ignore("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ ,:()$")
capture destring bmi_lbin*,   replace ignore("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ ,:()$")

* 1) Preserve originals before cleaning
foreach k of numlist 1/20 {
    capture confirm variable height_in`k'
    if !_rc gen height_orig`k' = height_in`k'
    capture confirm variable weight_lb`k'
    if !_rc gen weight_orig`k' = weight_lb`k'
}

* 2) Clean height & weight per visit
foreach k of numlist 1/20 {
    * height
    capture confirm variable height_in`k'
    if !_rc {
        replace height_in`k' = . if height_in`k' == 999 | height_in`k' <= 0
        replace height_in`k' = . if height_in`k' <= 53 | height_in`k' >= 84
    }
    * weight
    capture confirm variable weight_lb`k'
    if !_rc {
        replace weight_lb`k' = . if weight_lb`k' == 999 | weight_lb`k' <= 0
        replace weight_lb`k' = round(weight_lb`k', 0.1) if !missing(weight_lb`k')
        replace weight_lb`k' = . if weight_lb`k' <= 75 | weight_lb`k' >= 600
    }
}

* 3) Compute per-visit BMI (kg/m^2) with fallbacks; also rounded BMI
foreach k of numlist 1/20 {
    capture confirm variable height_in`k'
    if _rc continue

    * prepare BMI holder: rename bmi_lbin# -> bmi_kgm# if present; else create
    capture confirm variable bmi_lbin`k'
    if !_rc {
        rename bmi_lbin`k' bmi_kgm`k'
        capture destring bmi_kgm`k', replace ignore("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ ,:()$")
    }
    else {
        gen double bmi_kgm`k' = .
    }

    * helpers
    gen double kg`k'      = weight_lb`k'   / 2.2046226
    gen double m`k'       = height_in`k'   * 0.0254
    gen double orig_kg`k' = weight_orig`k' / 2.2046226
    gen double orig_m`k'  = height_orig`k' * 0.0254

    * primary BMI
    replace bmi_kgm`k' = kg`k' / (m`k'^2) if !missing(kg`k') & !missing(m`k')

    * fallbacks (match your long-form logic)
    replace bmi_kgm`k' = orig_kg`k' / (m`k'^2)      if missing(weight_lb`k') & !missing(height_in`k')
    replace bmi_kgm`k' = kg`k'      / (orig_m`k'^2) if !missing(weight_lb`k') & missing(height_in`k')
    replace bmi_kgm`k' = orig_kg`k' / (orig_m`k'^2) if missing(weight_lb`k') & missing(height_in`k')

    * rounded BMI for reporting
    gen double bmi_kgmR`k' = round(bmi_kgm`k', 0.1) if !missing(bmi_kgm`k')

    * drop helpers
    drop kg`k' m`k' orig_kg`k' orig_m`k'
}

* 4) CDC BMI categories per visit (string labels per visit)
foreach k of numlist 1/20 {
    capture confirm variable bmi_kgm`k'
    if _rc continue
    gen str12 bmi_Group`k' = ""
    replace bmi_Group`k' = "Underweight"  if !missing(bmi_kgm`k') & bmi_kgm`k' < 18.5
    replace bmi_Group`k' = "Normal"       if !missing(bmi_kgm`k') & bmi_kgm`k' >= 18.5 & bmi_kgm`k' < 25
    replace bmi_Group`k' = "Overweight"   if !missing(bmi_kgm`k') & bmi_kgm`k' >= 25   & bmi_kgm`k' < 30
    replace bmi_Group`k' = "Obese"        if !missing(bmi_kgm`k') & bmi_kgm`k' >= 30
    replace bmi_Group`k' = "" if missing(bmi_kgm`k')
}

rename patient_id record_id_main 

save "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\PE_to_merge_olddata.dta", replace

