tab er_stay_final,m
tab hospital_stay_6month_final,m
tab hospital_stay_final,m

ds has_*_final
foreach v of varlist `r(varlist)' {
    di "=============================="
    di "Tabulation of `v' vs jhu_cat_final"
    tab `v', missing
}

//certification 

foreach v in has_certANX_final has_certCancer_final has_certDEP_final ///
            has_certEXT_final has_certGERD_final has_certILD_final ///
            has_certOAD_final has_certPTSD_final has_certSA_final ///
            has_certSP_final has_certSRC_final has_certURD_final has_any_cert_final {
    tab `v', m
}

//stratify by er & hospital stay 

gen any_er_hos_final = .
replace any_er_hos_final = 1 if hospital_stay_final == 1 | er_stay_final == 1
replace any_er_hos_final = 0 if hospital_stay_final == 0 & er_stay_final == 0

tab any_er_hos_final, m

*========================
* Table 1 stratified by any_er_hos_final
*========================

