H="merge pilot1 & pilot2"

use "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\certification_pilot1data.dta",clear 

merge m:1 subject_id using "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\certification_pilot2data.dta"

local missing
forvalues i = 1/123 {
    count if subject_id == `i'
    if r(N) == 0 {
        local missing `missing' `i'
    }
}

display "Missing IDs: `missing'"

sort subject_id
drop _merge 
* Pair the ones with _one and _two
foreach base in has_certCancer has_certDEP has_certGERD has_certOAD has_certPTSD has_certSP has_certSRC has_certURD {
    gen `base'_pilot = max(`base'_one, `base'_two)
    replace `base'_pilot = 0 if missing(`base'_pilot)
}

* For ANX (no _new version), just copy
gen has_certANX_pilot = has_certANX
replace has_certANX_pilot = 0 if missing(has_certANX_pilot)

* Overall flag = 1 if ANY main cert is 1
egen has_any_cert_pilot = rowmax(has_certANX_pilot has_certCancer_pilot has_certDEP_pilot ///
    has_certGERD_pilot has_certOAD_pilot has_certPTSD_pilot has_certSP_pilot ///
    has_certSRC_pilot has_certURD_pilot)

* Ensure binary 0/1
replace has_any_cert_pilot = 0 if missing(has_any_cert_pilot)

* Count how many certification flags = 1
egen n_certs_pilot = rowtotal(has_certANX_pilot has_certCancer_pilot has_certDEP_pilot ///
    has_certGERD_pilot has_certOAD_pilot has_certPTSD_pilot has_certSP_pilot ///
    has_certSRC_pilot has_certURD_pilot)

foreach v in has_certANX_pilot has_certCancer_pilot has_certDEP_pilot has_certGERD_pilot ///
             has_certOAD_pilot has_certPTSD_pilot has_certSP_pilot has_certSRC_pilot has_certURD_pilot {
    tab `v'
}

* Collect all pilot + summary flags
ds has_cert*_pilot has_any_cert_pilot n_certs_pilot

* Tabulate each
foreach v of varlist `r(varlist)' {
    di "=============================="
    di "Tabulation of `v'"
    tab `v', missing
}

rename subject_id record_id_pilot 
drop *_one *_two has_certANX has_certCancer has_certDEP has_certGERD has_certOAD has_certPTSD has_certSP has_certSRC has_certURD

save "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\certification_pilotfinal.dta",replace




H="---"


H="occupatoin before 911 old"

//get pre-911 occupation ready 
// Load the dataset
import delimited "\\mssm2\mssm2$\wangy63\Personal\DesktopFiles\DC_FK Frailty assessment\FK250117 Frailty\FK250117_eaq.csv", clear
rename patient_id ptid 

* Create new variable with 4 occup categories
gen soc_4_categories = ""

* residual group (broken into groups of 5)
replace soc_4_categories = "residual" if inlist(majorsoc, ///
"11: Management Occupations", "13: Business & Financial Operations Occupations", ///
"15: Computer & Mathematical Occupations", "17: Architecture and Mathematical Occupations", ///
"19: Life, Physical, and Social Science Occupations")

replace soc_4_categories = "residual" if inlist(majorsoc, ///
"21: Community and Social Services Occupations", "23: Legal Occupations", ///
"25: Education, Training, and Library Occuapations", "27: Arts, Design, Entertainment, Sports & Media Occupations", ///
"29: Healthcare Practitioner and Technical Occupations")

replace soc_4_categories = "residual" if inlist(majorsoc, ///
"31: Healthcare Support Occupations", "35: Food Preparation and Serving Related Occupations", ///
"39: Personal Care and Service Occupations", "41: Sales and Related Occupations", ///
"43: Office and Administrative Support Occupations")

replace soc_4_categories = "residual" if inlist(majorsoc, ///
"45: Farming, Fishing, and Forestry Occupations", "51: Production Occupations", ///
"53: Transportation and Material Movers", "RETIRED", "UNEMPLOYED")

* Construction
replace soc_4_categories = "Construction" if majorsoc == "47: Construction Occupations"

* Protective
replace soc_4_categories = "Protective" if inlist(majorsoc, ///
"33: Protective Service Occupations", "55: Military Specific Occupations")

* Cleaning/Maintenance + Installation/Repair
replace soc_4_categories = "SOC37&49" if inlist(majorsoc, ///
"37: Building and Grounds Cleaning and Maintenance Occupations", ///
"49: Electrical, Telecommunications & Other Installation & Repair")

* Fix case and add Unknown + blanks to residual
replace soc_4_categories = "residual" if inlist(majorsoc,"Retired","Unemployed","Unknown","")

* Fix typos / spelling mismatches
replace soc_4_categories = "residual" if strpos(majorsoc,"Education, Training, and Library")
replace soc_4_categories = "residual" if strpos(majorsoc,"Food Prepar")   // covers "Prepara/Prepera-"


* Set missing if not classified
replace soc_4_categories = "" if soc_4_categories==""
rename soc_4_categories soc_4_categories_main 
tab soc_4_categories_main,m
rename ptid record_id_main 
tostring record_id_main,replace


save "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\pre911_group_old.dta",replace 


