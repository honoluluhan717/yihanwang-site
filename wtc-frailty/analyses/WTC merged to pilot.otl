tab exposure_final_num jhu_2cat_final,chi2 m

tab adl_cat_final jhu_2cat_final,chi2 m	
tab callahan_cat_final jhu_2cat_final,chi2 m
tab moca_cat_final jhu_2cat_final,chi2 m
tab fesi_cat_final jhu_2cat_final,chi2 m
tab fall_risk_final jhu_2cat_final,chi2 m
tab er_stay_6month_final jhu_2cat_final,chi2 m
tab er_stay_final jhu_2cat_final,chi2 m
tab hospital_stay_6month_final jhu_2cat_final,chi2 m
