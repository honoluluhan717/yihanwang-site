//table2 
foreach v in has_certANX_final has_certCancer_final has_certDEP_final ///
            has_certEXT_final has_certGERD_final has_certILD_final ///
            has_certOAD_final has_certPTSD_final has_certSA_final ///
            has_certSP_final has_certSRC_final has_certURD_final ///
