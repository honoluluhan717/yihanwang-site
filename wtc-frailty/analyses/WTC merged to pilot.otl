merge 1:1 patient_id using "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\certification_newdata.dta"
* === Build _main flags from _old/_new ===
local cats ANX Cancer DEP EXT GERD ILD OAD PTSD SA SP SRC URD
foreach c of local cats {
    capture confirm variable has_cert`c'_old
    if _rc gen byte has_cert`c'_old = .
    capture confirm variable has_cert`c'_new
    if _rc gen byte has_cert`c'_new = .
    egen has_cert`c'_main = rowmax(has_cert`c'_old has_cert`c'_new)
    replace has_cert`c'_main = 0 if missing(has_cert`c'_main)
}

* === Any + count flags across all _main ===
egen has_any_cert_main = rowmax( ///
    has_certANX_main has_certCancer_main has_certDEP_main has_certEXT_main has_certGERD_main ///
    has_certILD_main has_certOAD_main has_certPTSD_main has_certSA_main has_certSP_main ///
    has_certSRC_main has_certURD_main)
replace has_any_cert_main = 0 if missing(has_any_cert_main)

egen n_certs_main = rowtotal( ///
    has_certANX_main has_certCancer_main has_certDEP_main has_certEXT_main has_certGERD_main ///
    has_certILD_main has_certOAD_main has_certPTSD_main has_certSA_main has_certSP_main ///
    has_certSRC_main has_certURD_main)
replace n_certs_main = 0 if missing(n_certs_main)

* Tabulate each binary _main flag + any flag
ds has_cert*_main has_any_cert_main
foreach v of varlist `r(varlist)' {
    di "=============================="
    di "Tabulation of `v'"
    tab `v', missing
}

* Tabulate the count flag
di "=============================="
di "Tabulation of n_certs_main"
tab n_certs_main, missing

drop *_old *_new _merge 
rename patient_id record_id_main 
tostring record_id_main,replace

save "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\certification_maindata.dta",replace 


