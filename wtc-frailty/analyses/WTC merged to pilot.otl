rename education education_pilot 
save "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\initial data\merged to pilot\demo pilot_cleaned.dta",replace
restore
merge m:1 record_id_pilot using "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\initial data\merged to pilot\demo pilot_cleaned.dta",nogen force


//merge to redcap data 
preserve 
use "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\initial data\redcap0701_cleaned.dta",clear 

tempfile redcap2 
save `redcap2'
restore
merge m:1 record_id_main using `redcap2',nogen


merge m:1 record_id_pilot using "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\redcap0729_pilot.dta", nogen force


preserve 
use "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\initial data\merged to pilot\pilot_0728.dta",clear 
rename participant_id record_id_pilot
tempfile redcap3 
save `redcap3'
restore

merge m:1 record_id_pilot using `redcap3',nogen force

//merge to bmi
destring record_id_main,replace
merge m:1 record_id_main using "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\initial data\merged to pilot\bmi all main.dta",nogen

merge m:1 record_id_pilot using "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\bmi_pilotdata.dta", nogen force

//merge to smoke 
tostring record_id_main,replace
merge m:1 record_id_main using "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\initial data\merged to pilot\smoke all main.dta",nogen force
merge m:1 record_id_pilot using "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\recent smoke_pilotdata.dta", nogen force

//merge to occupation 
merge m:1 record_id_main using "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\initial data\merged to pilot\occupation all.dta",nogen force

destring record_id_pilot,replace
merge m:1 record_id_pilot using "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\pre911_group_pilot.dta",nogen force

//merge to exposure severity 
merge m:1 record_id_main using "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\initial data\merged to pilot\exposure all.dta",nogen force

merge m:1 record_id_pilot using "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\exposure_pilot.dta",nogen force

//merge to certification 

merge m:1 record_id_main using "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\certification_maindata.dta",nogen force 

merge m:1 record_id_pilot using "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\certification_pilotfinal.dta",nogen force 


//merge to income from pilot 

merge m:1 record_id_pilot using "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\initial data\merged to pilot\demo pilot.dta",nogen force update 

save "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\FINAL_MERGED 0728.dta",replace 


H="clean all demo + smoking done"

use "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\FINAL_MERGED 0728.dta",clear

drop if record_id_pilot==83 
drop if record_id_pilot==92 

* Build final JHU category and its source (pilot -> baseline -> fu1 -> fu2)
gen jhu_cat_final = .
gen str9 jhu_source = ""

replace jhu_cat_final = jhu_cat_p if !missing(jhu_cat_p)
replace jhu_source    = "pilot"         if jhu_source=="" & !missing(jhu_cat_p)

replace jhu_cat_final = jhu_cat_b       if missing(jhu_cat_final) & !missing(jhu_cat_b)
replace jhu_source    = "baseline"      if jhu_source=="" & !missing(jhu_cat_b)

replace jhu_cat_final = jhu_cat_fu1     if missing(jhu_cat_final) & !missing(jhu_cat_fu1)
replace jhu_source    = "fu1"           if jhu_source=="" & !missing(jhu_cat_fu1)

replace jhu_cat_final = jhu_cat_fu2     if missing(jhu_cat_final) & !missing(jhu_cat_fu2)
replace jhu_source    = "fu2"           if jhu_source=="" & !missing(jhu_cat_fu2)

* keep labels if the jhu_cat_* variables share a value label
cap label values jhu_cat_final jhu_cat
label var jhu_cat_final "JHU frailty category (earliest: pilot?baseline?fu1?fu2)"
label var jhu_source    "Source visit for jhu_cat_final"


* Frailty category final: use same-visit-as-JHU first, then fallback to any available
capture drop frail_cat_final
gen frail_cat_final = .

* 1) Same visit as JHU
replace frail_cat_final = frail_cat_p if jhu_source=="pilot"    & !missing(frail_cat_p)
replace frail_cat_final = frail_cat_b       if jhu_source=="baseline" & !missing(frail_cat_b)
replace frail_cat_final = frail_cat_fu1     if jhu_source=="fu1"      & !missing(frail_cat_fu1)
replace frail_cat_final = frail_cat_fu2     if jhu_source=="fu2"      & !missing(frail_cat_fu2)

* 2) Fallbacks: if still missing, take first available in priority (pilot -> baseline -> fu1 -> fu2)
replace frail_cat_final = frail_cat_p if missing(frail_cat_final) & !missing(frail_cat_p)
replace frail_cat_final = frail_cat_b       if missing(frail_cat_final) & !missing(frail_cat_b)
replace frail_cat_final = frail_cat_fu1     if missing(frail_cat_final) & !missing(frail_cat_fu1)
replace frail_cat_final = frail_cat_fu2     if missing(frail_cat_final) & !missing(frail_cat_fu2)

* Keep labels/description (if your frailty vars use label "frail_cat")
capture label values frail_cat_final frail_cat
label var frail_cat_final "Frailty category (JHU visit if present; else pilot?baseline?fu1?fu2)"

tab jhu_source, m
tab jhu_cat_final, m
tab frail_cat_final,m


//overall 

//gender 
gen gender_final = gender   // start with master version
replace gender_final = gender_pilot if missing(gender_final) & !missing(gender_pilot)
drop gender gender_pilot
tab gender_final

//Pick the survey date from the same visit as jhu_source
gen jhu_visit_date = .
replace jhu_visit_date = survey_date_pilot    if jhu_source=="pilot"
replace jhu_visit_date = survey_date_baseline if jhu_source=="baseline"
replace jhu_visit_date = survey_date_firstfp  if jhu_source=="fu1"
replace jhu_visit_date = survey_date_secondfp if jhu_source=="fu2"
format jhu_visit_date %td

//dob 
gen dob_num = date(dob, "YMD")
format dob_num %td

gen dob_pilot_num = dob_pilot
format dob_pilot_num %td

gen dob_final = dob_num
replace dob_final = dob_pilot_num if missing(dob_final) & !missing(dob_pilot_num)
format dob_final %td

* Age at JHU visit
gen age_at_jhu = (jhu_visit_date - dob_final) / 365.25
format age_at_jhu %9.2f
gen age_at_jhu_int = floor(age_at_jhu)

* Age groups
gen byte age_group = .
replace age_group = 1 if inrange(age_at_jhu_int,50,54)
replace age_group = 2 if inrange(age_at_jhu_int,55,64)
replace age_group = 3 if age_at_jhu_int>=65

label define agegrp 1 "50-54" 2 "55-64" 3 "65+"
label values age_group agegrp
tab age_group,m


//race 
gen race_final = race   // start with master version
replace race_final = race_pilot if missing(race_final) & !missing(race_pilot)
drop race race_pilot
tab race_final

//education
gen education_final = education   // start with master version
replace education_final = education_pilot if missing(education_final) & !missing(education_pilot)
drop education education_pilot
tab education_final


//smoking status 

//PILOT DATA 
* Create final smoking status from the appropriate source
preserve 
keep if jhu_source=="pilot"

* Closest visit ? final status; if that status is missing, backfill from prior visits
gen double __min = .
gen byte   k     = .
forvalues i=1/16 {
    replace k    = `i' if missing(__min) | abs(vis`i'dt - survey_date_pilot) < __min
    replace __min= abs(vis`i'dt - survey_date_pilot) if k==`i'
}
gen str30 smoking_status_final_pilot = ""
forvalues i=1/16 {
    replace smoking_status_final_pilot = smoking_status`i'_p if k==`i'
}
forvalues j=15(-1)1 {
    replace smoking_status_final_pilot = smoking_status`j'_p if smoking_status_final_pilot=="" & k>`j' & smoking_status`j'_p!=""
}
drop __min k


tab smoking_status_final_pilot,m
list record_id_pilot if smoking_status_final_pilot==""
keep merge_id record_id_pilot record_id_main smoking_status_final_pilot jhu_source
tempfile smoking_pilot
save `smoking_pilot'
restore 


//BASELINE DATA 
preserve 
keep if jhu_source=="baseline"

* Set "Unknown" to missing across smoking_status1–smoking_status20
forvalues i=1/20 {
    capture confirm string variable smoking_status`i'
    if !_rc {
        replace smoking_status`i' = "" if lower(strtrim(smoking_status`i'))=="unknown"
    }
    else {
        tempvar s
        capture decode smoking_status`i', gen(`s')
        if !_rc {
            replace smoking_status`i' = . if lower(strtrim(`s'))=="unknown"
            drop `s'
        }
    }
}

* Convert string dates to %td, pick closest visit to survey_date_baseline, backfill from prior if needed

* 1) baseline date (string ? %td)
capture confirm numeric variable survey_date_baseline
if _rc {
    gen double _sdb = daily(survey_date_baseline,"DMY")
    format _sdb %td
}
else gen double _sdb = survey_date_baseline

* 2) visit dates (strings ? %td helpers)
forvalues i=1/20 {
    gen double _vdt`i' = daily(visit_date`i',"DMY")
    format _vdt`i' %td
}

* 3) closest visit index (ignore missing dates)
gen double __min = .
gen byte   k     = .
forvalues i=1/20 {
    replace k     = `i' if _vdt`i'<. & (missing(__min) | abs(_vdt`i' - _sdb) < __min)
    replace __min = abs(_vdt`i' - _sdb) if k==`i'
}

* 4) final status at closest visit; if missing, use prior visit
gen str30 smoking_status_final_main = ""
forvalues i=1/20 {
    replace smoking_status_final_main = smoking_status`i' if k==`i'
}
forvalues j=19(-1)1 {
    replace smoking_status_final_main = smoking_status`j' if smoking_status_final_main=="" & k>`j' & smoking_status`j'!=""
}

drop _vdt1-_vdt20 _sdb __min k


rename smoking_status_final_main smoking_status_final_baseline

tab smoking_status_final_baseline,m
list smoking_status1- smoking_status20 if smoking_status_final_baseline=="Unknown"
keep merge_id record_id_pilot record_id_main smoking_status_final_baseline jhu_source
tempfile smoking_baseline
save `smoking_baseline'
restore 

//FIRST FOLLOW UP 
preserve 
keep if jhu_source=="fu1"

* Set "Unknown" to missing across smoking_status1–smoking_status20
forvalues i=1/20 {
    capture confirm string variable smoking_status`i'
    if !_rc {
        replace smoking_status`i' = "" if lower(strtrim(smoking_status`i'))=="Unknown"
    }
    else {
        tempvar s
        capture decode smoking_status`i', gen(`s')
        if !_rc {
            replace smoking_status`i' = . if lower(strtrim(`s'))=="Unknown"
            drop `s'
        }
    }
}

* Convert string dates to %td, pick closest visit to survey_date_baseline, backfill from prior if needed

* 1) baseline date (string ? %td)
capture confirm numeric variable survey_date_firstfp
if _rc {
    gen double _sdb = daily(survey_date_firstfp,"DMY")
    format _sdb %td
}
else gen double _sdb = survey_date_firstfp

* 2) visit dates (strings ? %td helpers)
forvalues i=1/20 {
    gen double _vdt`i' = daily(visit_date`i',"DMY")
    format _vdt`i' %td
}

* 3) closest visit index (ignore missing dates)
gen double __min = .
gen byte   k     = .
forvalues i=1/20 {
    replace k     = `i' if _vdt`i'<. & (missing(__min) | abs(_vdt`i' - _sdb) < __min)
    replace __min = abs(_vdt`i' - _sdb) if k==`i'
}

* 4) final status at closest visit; if missing, use prior visit
gen str30 smoking_status_final_main = ""
forvalues i=1/20 {
    replace smoking_status_final_main = smoking_status`i' if k==`i'
}
forvalues j=19(-1)1 {
    replace smoking_status_final_main = smoking_status`j' if smoking_status_final_main=="" & k>`j' & smoking_status`j'!=""
}

drop _vdt1-_vdt20 _sdb __min k


rename smoking_status_final_main smoking_status_final_first_fp

tab smoking_status_final_first_fp,m
keep merge_id record_id_pilot record_id_main smoking_status_final_first_fp jhu_source
tempfile smoking_firstfollowup
save `smoking_firstfollowup'
restore 

preserve 
use `smoking_firstfollowup',clear 
merge 1:1 record_id_main using `smoking_baseline'
drop _merge
merge m:1 record_id_pilot using `smoking_pilot'

gen str10 smoking_status_final=""
replace smoking_status_final = smoking_status_final_baseline if jhu_source=="baseline"
replace smoking_status_final = smoking_status_final_first_fp if jhu_source=="fu1"
replace smoking_status_final = smoking_status_final_pilot    if jhu_source=="pilot"
drop _merge 

tab smoking_status_final,m
tempfile smoking_all 
save `smoking_all'
restore 


drop _merge 
merge 1:1 merge_id using `smoking_all'

//if jhu is missing 
* earliest from MAIN (smoking_status1..20)
gen str30 _earliest_main = ""
foreach v in smoking_status1 smoking_status2 smoking_status3 smoking_status4 smoking_status5 ///
               smoking_status6 smoking_status7 smoking_status8 smoking_status9 smoking_status10 ///
               smoking_status11 smoking_status12 smoking_status13 smoking_status14 smoking_status15 ///
               smoking_status16 smoking_status17 smoking_status18 smoking_status19 smoking_status20 {
    replace _earliest_main = `v' if _earliest_main=="" & `v'!=""
}

* earliest from PILOT (smoking_status1_p..20_p)
gen str30 _earliest_pilot = ""
foreach v in smoking_status1_p smoking_status2_p smoking_status3_p smoking_status4_p smoking_status5_p ///
               smoking_status6_p smoking_status7_p smoking_status8_p smoking_status9_p smoking_status10_p ///
               smoking_status11_p smoking_status12_p smoking_status13_p smoking_status14_p smoking_status15_p ///
               smoking_status16_p {
    replace _earliest_pilot = `v' if _earliest_pilot=="" & `v'!=""
}

* If BOTH smoking_status_final and jhu_source are missing:
* 1) fill from MAIN when main id present
replace smoking_status_final = _earliest_main  if smoking_status_final=="" & missing(jhu_source) & !missing(record_id_main)

* 2) fill from PILOT when pilot id present
replace smoking_status_final = _earliest_pilot if smoking_status_final=="" & missing(jhu_source) & !missing(record_id_pilot)

* 3) if BOTH ids present, prefer PILOT (override)
replace smoking_status_final = _earliest_pilot if smoking_status_final=="" & missing(jhu_source) ///
    & !missing(record_id_main) & !missing(record_id_pilot) & _earliest_pilot!=""

drop _earliest_main _earliest_pilot


tab smoking_status_final,m


