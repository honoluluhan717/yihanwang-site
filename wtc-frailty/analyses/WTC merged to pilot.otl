H="regression output abstract "
log using "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\output\output 0929.smcl",replace 

use "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\all done 0919.dta",clear 

keep if !missing(jhu_source)

gen byte jhu_2cat_final = .
replace jhu_2cat_final = 0 if jhu_cat_final == 0   // Not Frail
replace jhu_2cat_final = 1 if inlist(jhu_cat_final, 1, 2)   // Pre-Frail or Frail

label define jhu2 0 "Not Frail" 1 "Pre-Frail or Frail"
label values jhu_2cat_final jhu2

* Check
tab jhu_cat_final jhu_2cat_final, m

* Combine Normal + Underweight into one category from the ORIGINAL string var
gen byte bmi_Group_final_combined = .
replace bmi_Group_final_combined = 0 if inlist(lower(strtrim(bmi_Group_final)), "normal", "underweight")
replace bmi_Group_final_combined = 1 if lower(strtrim(bmi_Group_final)) == "obese"
replace bmi_Group_final_combined = 2 if lower(strtrim(bmi_Group_final)) == "overweight"

label define bmi_comb 0 "Normal+Underweight" 1 "Obese" 2 "Overweight", replace
label values bmi_Group_final_combined bmi_comb

sum jhu_2cat_final gender_final age_group race_final smoking_status_final bmi_Group_final_combined soc_4_categories_final education_final exposure_final has_*_final adl_cat_final callahan_cat_final moca_cat_final fesi_cat_final fall_risk_final er_stay_final hospital_stay_final

summarize age_at_jhu, meanonly
replace age_at_jhu = r(mean) if missing(age_at_jhu)

gen str20 education_regrped_final = ""
replace education_regrped_final = "Some College"          if education_final == "<BA/BS"
replace education_regrped_final = "Less than high school" if education_final == "<HS Grad"
replace education_regrped_final = "College"               if inlist(education_final, "BA/BS", "Grad Sch")
replace education_regrped_final = "High School"           if education_final == "HS Grad"
replace education_regrped_final = "Not Reported"          if education_final == "Unknown"

//multiple imputation 

* 1. Set data for MI
mi set wide

encode exposure_final, gen(exposure_final_num)
encode smoking_status_final, gen(smoking_status_final_num)
encode gender_final, gen(gender_final_num)
encode race_final, gen(race_final_num)
encode soc_4_categories_final, gen(soc_4_categories_final_num)
encode education_regrped_final, gen(education_regrped_final_num)


* 2. Register vars with missing
mi register imputed moca_cat_final exposure_final_num smoking_status_final_num bmi_Group_final_combined
mi register regular jhu_2cat_final gender_final_num age_at_jhu race_final_num soc_4_categories_final_num education_regrped_final_num adl_cat_final callahan_cat_final fesi_cat_final fall_risk_final er_stay_final hospital_stay_final has_certCancer_final has_certDEP_final has_certEXT_final has_certGERD_final has_certILD_final has_certOAD_final has_certPTSD_final has_certSA_final has_certSP_final has_certSRC_final has_certURD_final has_any_cert_final

mi impute chained ///
    (mlogit, augment) exposure_final_num smoking_status_final_num bmi_Group_final_combined ///
    (ologit, augment) moca_cat_final ///
    = jhu_2cat_final gender_final_num age_at_jhu race_final_num soc_4_categories_final_num ///
      education_regrped_final_num has_any_cert_final adl_cat_final callahan_cat_final fesi_cat_final ///
      fall_risk_final er_stay_final hospital_stay_final ///
      has_certCancer_final has_certDEP_final has_certEXT_final has_certGERD_final has_certILD_final ///
      has_certOAD_final has_certPTSD_final has_certSA_final has_certSP_final has_certSRC_final has_certURD_final, ///
    add(20) rseed(12345)
	
* Make Normal+Underweight the reference for factor notation
mi fvset base 0 bmi_Group_final_combined
mi fvset base 3 exposure_final_num
mi fvset base 5 race_final_num
mi fvset base 3 education_regrped_final_num
	  
* Logistic regression with MI, allowing the estimation sample to vary across imputations
mi estimate, or esampvaryok: logistic jhu_2cat_final ///
    i.gender_final_num c.age_at_jhu ///
    i.race_final_num i.smoking_status_final_num i.bmi_Group_final_combined i.exposure_final_num ///
    i.soc_4_categories_final_num i.education_regrped_final_num ///
    i.adl_cat_final i.callahan_cat_final i.moca_cat_final ///
    i.fesi_cat_final i.fall_risk_final i.er_stay_final i.hospital_stay_final ///
    1.has_any_cert_final

mi estimate, or esampvaryok: logistic jhu_2cat_final ///
    i.gender_final_num c.age_at_jhu ///
    i.race_final_num i.smoking_status_final_num i.bmi_Group_final_combined i.exposure_final_num ///
    i.soc_4_categories_final_num i.education_regrped_final_num ///
    i.adl_cat_final i.callahan_cat_final i.moca_cat_final ///
    i.fesi_cat_final i.fall_risk_final i.er_stay_final i.hospital_stay_final i.has_any_cert_final ///
	i.has_certCancer_final i.has_certDEP_final i.has_certEXT_final i.has_certGERD_final i.has_certILD_final ///
	i.has_certOAD_final i.has_certPTSD_final i.has_certSA_final i.has_certSP_final i.has_certSRC_final i.has_certURD_final i.has_any_cert_final
	
	
