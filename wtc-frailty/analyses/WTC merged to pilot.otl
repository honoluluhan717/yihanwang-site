}

translate "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\output\descriptive output 1006.smcl" "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\output\descriptive output 1006.pdf"

log close 

H="certification groups "
use "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\all done 0919.dta",clear 
keep if !missing(jhu_source)

gen has_any_mental_condition = has_certPTSD_final == 1 | has_certANX_final == 1 | has_certDEP_final == 1

//recode 3 category race 
gen race3_final = .

replace race3_final = 1 if race_final == "White"
replace race3_final = 2 if race_final == "Black"
replace race3_final = 3 if inlist(race_final, "Asian", "Other", "Unknown")

label define race3lab 1 "White" 2 "Black" 3 "Other"
label values race3_final race3lab

tab race3_final

//recode binary education 
gen education2_final = .

* < college
replace education2_final = 1 if inlist(education_final, "<HS Grad", "HS Grad", "<BA/BS")

* College or more
replace education2_final = 2 if inlist(education_final, "BA/BS", "Grad Sch")

* Unknown
replace education2_final = 3 if education_final == "Unknown"

* Label the categories
label define edu2lab 1 "<College" 2 "College or more" 3 "Unknown"
label values education2_final edu2lab

tab education2_final

//recode binary smoking status 
gen smoke2_final = . 
replace smoke2_final = 1 if inlist(smoking_status_final, "Current smoker", "Former smoker")
replace smoke2_final = 0 if smoking_status_final == "Never smoker"
label define smoke2lab 1 "Current/Former smoker" 0 "Never smoker"
label values smoke2_final smoke2lab

tab smoke2_final

//recode BMI to 3 category 
gen bmi3_final = .
replace bmi3_final = 1 if inlist(bmi_Group_final, "Normal", "Underweight")
replace bmi3_final = 2 if bmi_Group_final == "Overweight"
replace bmi3_final = 3 if bmi_Group_final == "Obese"
label define bmi3lab 1 "Normal/Underweight" 2 "Overweight" 3 "Obese"
label values bmi3_final bmi3lab

tab bmi3_final

//recode binary MOCA 
gen moca2_final = .
replace moca2_final = 0 if moca_cat_final == 0
replace moca2_final = 1 if inlist(moca_cat_final, 1, 2)
label define moca2lab 0 "Normal" 1 "Mild/Moderate/Severe"
label values moca2_final moca2lab

tab moca2_final

//recode binary jhu 
gen jhu_frail_binary = .
replace jhu_frail_binary = 0 if jhu_cat_final == 0
replace jhu_frail_binary = 1 if inlist(jhu_cat_final, 1, 2)

tab jhu_frail_binary

//Cancer 
ttest age_at_jhu_int, by (has_certCancer_final)

foreach var in jhu_frail_binary jhu_frail_binary gender_final race3_final education2_final smoke2_final bmi3_final soc_4_categories_final adl_cat_final moca2_final fesi_cat_final fall_risk_final er_stay_final hospital_stay_final {
tab `var' has_certCancer_final,chi2 
}

//GERD 
ttest age_at_jhu_int, by (has_certGERD_final)

foreach var in jhu_frail_binary gender_final race3_final education2_final smoke2_final bmi3_final soc_4_categories_final adl_cat_final moca2_final fesi_cat_final fall_risk_final er_stay_final hospital_stay_final {
tab `var' has_certGERD_final,chi2 
}

//OAD
ttest age_at_jhu_int, by (has_certOAD_final)

foreach var in jhu_frail_binary gender_final race3_final education2_final smoke2_final bmi3_final soc_4_categories_final adl_cat_final moca2_final fesi_cat_final fall_risk_final er_stay_final hospital_stay_final {
tab `var' has_certOAD_final,chi2 
}

//URD
ttest age_at_jhu_int, by (has_certURD_final)

foreach var in jhu_frail_binary gender_final race3_final education2_final smoke2_final bmi3_final soc_4_categories_final adl_cat_final moca2_final fesi_cat_final fall_risk_final er_stay_final hospital_stay_final {
tab `var' has_certURD_final,chi2 
}

//Any certificate 
ttest age_at_jhu_int, by (has_any_cert_final)

foreach var in jhu_frail_binary gender_final race3_final education2_final smoke2_final bmi3_final soc_4_categories_final adl_cat_final moca2_final fesi_cat_final fall_risk_final er_stay_final hospital_stay_final {
tab `var' has_any_cert_final,chi2 
}

//PTSD 
ttest age_at_jhu_int, by (has_certPTSD_final)

foreach var in jhu_frail_binary gender_final race3_final education2_final smoke2_final bmi3_final soc_4_categories_final adl_cat_final moca2_final fesi_cat_final fall_risk_final er_stay_final hospital_stay_final {
tab `var' has_certPTSD_final,chi2 
}


//Any mental health 
ttest age_at_jhu_int, by (has_any_mental_condition)

foreach var in jhu_frail_binary gender_final race3_final education2_final smoke2_final bmi3_final soc_4_categories_final adl_cat_final moca2_final fesi_cat_final fall_risk_final er_stay_final hospital_stay_final {
tab `var' has_any_mental_condition,chi2 
}

//regression outcomes - fesi 
gen fesi2_final = .
replace fesi2_final = 0 if fesi_cat_final == 0   // Low Fear
replace fesi2_final = 1 if inlist(fesi_cat_final,1,2)   // Moderate/High Fear
label define fesi2 0 "Low Fear" 1 "Moderate/High Fear"
label values fesi2_final fesi2
tab fesi2_final

encode gender_final, gen(gender_final_num)
drop gender_final
rename gender_final_num gender_final


*model1 
logistic fesi2_final i.jhu_frail_binary##i.has_any_cert_final

*model2 
logistic fesi2_final i.jhu_frail_binary##i.has_any_cert_final age_at_jhu_int i.gender_final i.race3_final i.education2_final

encode soc_4_categories_final, gen(x)
drop soc_4_categories_final
rename x soc_4_categories_final

*model3 
logistic fesi2_final i.jhu_frail_binary##i.has_any_cert_final age_at_jhu_int i.gender_final i.race3_final i.education2_final i.smoke2_final i.bmi3_final i.soc_4_categories_final i.adl_cat_final i.moca2_final i.fall_risk_final i.er_stay_final i.hospital_stay_final

//regression outcomes - fall risk 
*model1 
logistic fall_risk_final i.jhu_frail_binary##i.has_any_cert_final

*model2 
logistic fall_risk_final i.jhu_frail_binary##i.has_any_cert_final age_at_jhu_int i.gender_final i.race3_final i.education2_final

*model3 
logistic fall_risk_final i.jhu_frail_binary##i.has_any_cert_final age_at_jhu_int i.gender_final i.race3_final i.education2_final i.smoke2_final i.bmi3_final i.soc_4_categories_final i.adl_cat_final i.moca2_final i.fesi_cat_final i.er_stay_final i.hospital_stay_final


//regression outcomes - ER or hospital stay 

gen er_hos_final = 0
replace er_hos_final = 1 if er_stay_final == 1 | hospital_stay_final == 1

*model1 
logistic er_hos_final i.jhu_frail_binary##i.has_any_cert_final

*model2 
logistic er_hos_final i.jhu_frail_binary##i.has_any_cert_final age_at_jhu_int i.gender_final i.race3_final i.education2_final

*model3 
logistic er_hos_final i.jhu_frail_binary##i.has_any_cert_final age_at_jhu_int i.gender_final i.race3_final i.education2_final i.smoke2_final i.bmi3_final i.soc_4_categories_final i.adl_cat_final i.moca2_final i.fesi_cat_final i.fall_risk_final


