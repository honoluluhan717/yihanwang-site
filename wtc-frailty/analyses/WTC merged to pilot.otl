}

//chart for certifications 
preserve

local certs has_certANX_final has_certCancer_final has_certDEP_final ///
            has_certEXT_final has_certGERD_final has_certILD_final ///
            has_certOAD_final has_certPTSD_final has_certSA_final ///
            has_certSP_final has_certSRC_final has_certURD_final ///
            has_any_cert_final

keep `certs'
gen id = _n
reshape long has_, i(id) j(cert) string

collapse (mean) pct_yes = has_, by(cert)
replace pct_yes = 100*pct_yes

replace cert = subinstr(cert,"has_cert","",.)
replace cert = subinstr(cert,"_final","",.)

graph hbar pct_yes, over(cert, sort(1) descending) ///
    ytitle("Percent (%)") ///
    title("Certification prevalence") ///
    blabel(bar, format(%4.1f) position(outside))
	

restore


//table3 logistic regression 
//model1 demographics + WTC 
foreach v in gender_final race_final education_final bmi_Group_final ///
            smoking_status_final exposure_final {
    encode `v', gen(`v'_num)
    drop `v'
    rename `v'_num `v'
}

fvset base 3 exposure_final
fvset base 3 smoking_status_final
fvset base 4 race_final
fvset base 2 gender_final


//imputation 

gen jhu_binary_final = .
replace jhu_binary_final = 0 if jhu_cat_final == 0
replace jhu_binary_final = 1 if inlist(jhu_cat_final, 1, 2)

label define jhu_bin 0 "Not frail" 1 "Pre-frail/Frail"
label values jhu_binary_final jhu_bin
tab jhu_binary_final,m


set seed 12345

mi set mlong

mi register regular any_er_hos_final gender_final jhu_binary_final
mi register imputed age_at_jhu_int race_final education_final bmi_Group_final ///
                    smoking_status_final exposure_final has_any_cert_final


mi impute chained ///
    (regress) age_at_jhu_int ///
    (mlogit, augment) race_final smoking_status_final ///
    (ologit) education_final bmi_Group_final exposure_final ///
    (logit) has_any_cert_final ///
    = i.gender_final any_er_hos_final i.jhu_binary_final, ///
    add(20) rseed(12345) force

mi estimate, or: logistic any_er_hos_final ///
    i.gender_final age_at_jhu_int ///
    i.race_final i.education_final i.bmi_Group_final ///
    i.smoking_status_final i.exposure_final ///
    i.has_any_cert_final

mi estimate, or: logistic any_er_hos_final ///
    i.gender_final age_at_jhu_int ///
    i.race_final i.education_final i.bmi_Group_final ///
    i.smoking_status_final i.exposure_final ///
    i.jhu_binary_final

mi estimate, or: logistic any_er_hos_final ///
    i.gender_final age_at_jhu_int ///
    i.race_final i.education_final i.bmi_Group_final ///
    i.smoking_status_final i.exposure_final ///
    i.has_any_cert_final##i.jhu_binary_final

	

