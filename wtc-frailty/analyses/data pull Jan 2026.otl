H="create main data with new ID"

*reshape the redcap dataset from long to wide, keep survey dates for each visit, and create merge_id equals to record_id_main 

use "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\initial data\merged to pilot\WTCII_DATA_2026-01-16_1102.dta",clear 

keep record_id redcap_event_name survey_date

//fix ID errors 
replace record_id = "16" if record_id == "16 (withdrawn)"
replace record_id = "50" if record_id == "50 (withdrawn)"
replace record_id = "86" if record_id == "86 (withdrawn)"
replace record_id = "88" if record_id == "88 (Withdrawn)"

//Reshape the main database 
//create visit names
gen visit = ""
replace visit = "baseline" if redcap_event_name == "baseline_arm_1"
replace visit = "first"    if redcap_event_name == "first_follow_up_arm_1"
replace visit = "second"   if redcap_event_name == "second_follow_up_arm_1"
replace visit = "third"   if redcap_event_name == "third_follow_up_arm_1"

//Convert survey_date string to Stata date format
gen survey_date_clean = date(survey_date, "MDY")
format survey_date_clean %td

//Keep only relevant variables
keep record_id visit survey_date_clean
drop if missing(visit) | missing(survey_date_clean)

//Collapse in case of duplicates (keep earliest per visit per ID)
collapse (min) survey_date_clean, by(record_id visit)

//Reshape to wide
reshape wide survey_date_clean, i(record_id) j(visit) string

//add duplicate flag in the main data 
gen overlap_main_pilot=.
replace overlap_main_pilot=1 if record_id=="34" | record_id=="32" | record_id=="21" | record_id=="36" | record_id=="4847" | record_id=="121" | record_id=="38" | record_id=="43" | record_id=="49" | record_id=="25" | record_id=="50" | record_id=="118" | record_id=="51" | record_id=="99" | record_id=="77" | record_id=="3102" | record_id=="1487" | record_id=="22" | record_id=="116" | record_id=="194" | record_id=="41" | record_id=="2332" | record_id=="67" | record_id=="1105" | record_id=="55"

// Rename for clarity
rename survey_date_cleanbaseline survey_date_baseline
rename survey_date_cleanfirst survey_date_firstfp
rename survey_date_cleansecond survey_date_secondfp
rename survey_date_cleanthird survey_date_thirdfp

gen record_id_main=record_id

//sort record ID 
destring record_id, replace
gsort record_id 

gen merge_id = record_id
list record_id merge_id if overlap_main_pilot==1

gen unique_in_main=.
replace unique_in_main=1 if overlap_main_pilot!=1
tab unique_in_main
tab overlap_main_pilot

save "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\initial data\merged to pilot\main data with new ID Jan 2026.dta",replace 





