use "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\all done 0919 Jan 2026.dta",clear 

keep if !missing(jhu_source)


gen has_any_mental_condition_final = has_certPTSD_final == 1 | has_certANX_final == 1 | has_certDEP_final == 1 | has_certSA_final
rename has_any_mental_condition_final has_any_ment_cond

gen has_any_BUT_mentalhealth = has_any_cert_final == 1 & has_any_ment_cond == 0


gen bmi_Group_combined = bmi_Group_final
replace bmi_Group_combined = "Normal/Underweight" if inlist(bmi_Group_final, "Normal", "Underweight")
drop bmi_Group_final
rename bmi_Group_combined bmi_Group_final

gen exposure_combined = exposure_final
replace exposure_combined = "High/Very High" if inlist(exposure_final, "High", "Very High")
drop exposure_final
rename exposure_combined exposure_final

gen education_recode = education_final

replace education_recode = "<=High school" if inlist(education_final, "<HS Grad", "HS Grad")
replace education_recode = "Some college"  if education_final == "<BA/BS"
replace education_recode = "College"       if inlist(education_final, "BA/BS", "Grad Sch")
replace education_recode = ""               if education_final == "Unknown"

drop education_final
rename education_recode education_final

replace race_final = "" if race_final == "Unknown"

recode moca_cat_final (2 = 1)
label define moca_cat_final 0 "Normal" 1 "Cognitively impaired"
label values moca_cat_final moca_cat_final
tab moca_cat_final

gen income_cat_final = .

replace income_cat_final = 1 if inlist(income_category,"$0-$10K",">$10-20K",">$20-30K",">$30-40K")
replace income_cat_final = 2 if inlist(income_category,">$40-50K",">$50-60K",">$60-70K",">$70-80K",">$80-90K") | inlist(income_category, ">$90-100K",">$100-110K",">$110-120K",">$120-130K",">$130-140K",">$140")
replace income_cat_final = . if income_category=="M"

label define income_cat_final 1 "Low (<40K)" 2 "Non-Low (>40K)" 
label values income_cat_final income_cat_final

tab income_category
tab income_cat_final


*label define adl_cat 0 "Independent" 1 "Disabled" 2 "Unknown"
replace adl_cat_final = . if adl_cat_final == 2   // drop unknown
replace adl_cat_final = 2 if adl_cat_final == 0   // temp swap
replace adl_cat_final = 0 if adl_cat_final == 1
replace adl_cat_final = 1 if adl_cat_final == 2

label define adl_cat_final 0 "Independent" 1 "Disabled", replace
label values adl_cat_final adl_cat_final
tab adl_cat_final



local vars jhu_cat_final fesi_cat_final fall_risk_final falls_year_final ///
           moca_cat_final callahan_cat_final soc_4_categories_final ///
           exposure_final age_group gender_final race_final ///
           bmi_Group_final education_final smoking_status_final ///
           income_cat_final has_any_ment_cond has_any_BUT_mentalhealth ///
		   has_certURD_final has_certPTSD_final has_certCancer_final has_certGERD_final has_any_cert_final

foreach v of local vars {
    di "=============================="
    di "Chi-square test: adl_cat_final vs `v'"
    tab adl_cat_final `v' if adl_cat_final!=., chi2 m
}

ttest n_certs_final,by(adl_cat_final)
ttest age_at_jhu,by(adl_cat_final)

*********************************//logistic modeling**********************************
keep if adl_cat_final!=.

foreach var of varlist age_at_jhu_int income_cat_final has_any_BUT_mentalhealth has_any_ment_cond jhu_cat_final fesi_cat_final falls_year_final moca_cat_final {
	tab `var',m
}

mi set wide 

mi register imputed income_cat_final moca_cat_final age_at_jhu_int
mi register regular has_any_BUT_mentalhealth has_any_ment_cond jhu_cat_final fesi_cat_final falls_year_final

mi impute chained ///
    (regress) age_at_jhu_int ///
    (mlogit, augment) moca_cat_final ///
	(ologit, augment) income_cat_final ///
    = has_any_BUT_mentalhealth has_any_ment_cond jhu_cat_final fesi_cat_final, ///
    add(20) rseed(12345)

mi fvset base 2 income_cat_final
mi fvset base 0 adl_cat_final

//full sample cohort 

mi estimate, or esampvaryok: logistic adl_cat_final age_at_jhu_int i.income_cat_final i.has_any_BUT_mentalhealth i.has_any_ment_cond 

mi estimate, or esampvaryok: logistic adl_cat_final age_at_jhu_int i.income_cat_final i.has_any_BUT_mentalhealth i.has_any_ment_cond i.jhu_cat_final i.fesi_cat_final i.falls_year_final i.moca_cat_final

//male only conhort 

tab gender_final if adl_cat_final!=.

mi estimate, or esampvaryok: logistic adl_cat_final age_at_jhu_int i.income_cat_final i.has_any_BUT_mentalhealth i.has_any_ment_cond if gender_final=="Male"

mi estimate, or esampvaryok: logistic adl_cat_final age_at_jhu_int i.income_cat_final i.has_any_BUT_mentalhealth i.has_any_ment_cond i.jhu_cat_final i.fesi_cat_final i.falls_year_final i.moca_cat_final if gender_final=="Male"

//Female only conhort 

tab gender_final if adl_cat_final!=.

mi estimate, or esampvaryok: logistic adl_cat_final age_at_jhu_int i.income_cat_final i.has_any_BUT_mentalhealth i.has_any_ment_cond if gender_final=="Female"

mi estimate, or esampvaryok: logistic adl_cat_final age_at_jhu_int i.income_cat_final i.has_any_BUT_mentalhealth i.has_any_ment_cond i.jhu_cat_final i.fesi_cat_final i.falls_year_final i.moca_cat_final if gender_final=="Female"





