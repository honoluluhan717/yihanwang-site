* tidy final
* ----------------------------
replace generic_std = regexr(generic_std, " +", " ")
replace generic_std = trim(generic_std)

tab generic_std

*====================================================*
* FINAL FILLER-WORD STRIP + CORE NAME RE-COLLAPSE    *
*====================================================*

replace generic_std = upper(trim(generic_std))

* remove numbers
replace generic_std = regexr(generic_std, "[0-9]+", " ")

* remove common filler / route / form / timing words
replace generic_std = regexr(generic_std, ///
"\b(ONE|DAY|DAYS|WEEK|WEEKLY|MONTH|MONTHLY|DAILY|NIGHTLY|TWICE|THREE|TIMES|AS|DIR|DIRECTED|NEEDED|USE|USED|VERY|RARELY|PRN|TAB|TABS|TABLET|TABLETS|CAP|CAPS|CAPSULE|CAPSULES|SOLUTION|SOLN|SUSPENSION|SYRUP|INJECTION|INJ|SPRAY|AEROSOL|DOSE|DOSES|POWDER|POWD|CREAM|OINTMENT|OINT|PATCH|GEL|DROPS|DROP|SUPP|SUPPS|EXTENDED|RELEASE|XR|ER|DR|EC|OTC|NON|AEROSOL|SUBLINGUAL|FLEXTOUCH|WD)\b", " ")

* remove leftover chemical salt words / noise words
replace generic_std = regexr(generic_std, ///
"\b(HYDROCHLORIDE|CHLORIDE|BROMIDE|SULFATE|SODIUM|CALCIUM|MAGNESIUM|ACETATE|FUROATE|PROPIONATE|ACETONIDE|MONOHYDRATE|HBR|USP)\b", " ")

* normalize spaces again
replace generic_std = regexr(generic_std, "[^A-Z\- ]", " ")
replace generic_std = regexr(generic_std, " +", " ")
replace generic_std = trim(generic_std)

* re-collapse to core categories after filler removal
