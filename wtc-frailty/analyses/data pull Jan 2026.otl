//fall risk 
gen fall_risk_final = .

replace fall_risk_final = fall_risk_b   if jhu_source=="baseline" & fall_risk_b   <.
replace fall_risk_final = fall_risk_fu2 if jhu_source=="fu2"      & fall_risk_fu2 <.
replace fall_risk_final = fall_risk_p   if jhu_source=="pilot"    & fall_risk_p   <.

replace fall_risk_final = fall_risk_p   if missing(fall_risk_final) & fall_risk_p   <.
replace fall_risk_final = fall_risk_b   if missing(fall_risk_final) & fall_risk_b   <.
replace fall_risk_final = fall_risk_fu2 if missing(fall_risk_final) & fall_risk_fu2 <.

tab fall_risk_final,m

gen falls_year_final = .

replace falls_year_final = falls_year_b   if jhu_source=="baseline" & falls_year_b   < .
replace falls_year_final = falls_year_fu2 if jhu_source=="fu2"      & falls_year_fu2 < .
replace falls_year_final = falls_year  if jhu_source=="pilot"    & falls_year   < .

replace falls_year_final = falls_year   if missing(falls_year_final) & falls_year   < .
replace falls_year_final = falls_year_b   if missing(falls_year_final) & falls_year_b   < .
replace falls_year_final = falls_year_fu2 if missing(falls_year_final) & falls_year_fu2 < .

tab falls_year_final, m

gen falls_year_mult_final = .

replace falls_year_mult_final = falls_year_mult_b   if jhu_source=="baseline" & falls_year_mult_b   < .
replace falls_year_mult_final = falls_year_mult_fu2 if jhu_source=="fu2"      & falls_year_mult_fu2 < .
replace falls_year_mult_final = falls_year_mult_p   if jhu_source=="pilot"    & falls_year_mult_p   < .

replace falls_year_mult_final = falls_year_mult_p   if missing(falls_year_mult_final) & falls_year_mult_p   < .
replace falls_year_mult_final = falls_year_mult_b   if missing(falls_year_mult_final) & falls_year_mult_b   < .
replace falls_year_mult_final = falls_year_mult_fu2 if missing(falls_year_mult_final) & falls_year_mult_fu2 < .

tab falls_year_mult_final, m

gen falls_afraid_final = .

replace falls_afraid_final = falls_afraid_b   if jhu_source=="baseline" & falls_afraid_b   < .
replace falls_afraid_final = falls_afraid_fu2 if jhu_source=="fu2"      & falls_afraid_fu2 < .
replace falls_afraid_final = falls_afraid   if jhu_source=="pilot"    & falls_afraid   < .

replace falls_afraid_final = falls_afraid   if missing(falls_afraid_final) & falls_afraid  < .
replace falls_afraid_final = falls_afraid_b   if missing(falls_afraid_final) & falls_afraid_b   < .
replace falls_afraid_final = falls_afraid_fu2 if missing(falls_afraid_final) & falls_afraid_fu2 < .

tab falls_afraid_final, m

//ER
* ER stay aligned to the visit where JHU was collected
capture drop er_stay_final
gen er_stay_final = .

replace er_stay_final = er_stay_b   if jhu_source=="baseline" & er_stay_b   <.
replace er_stay_final = er_stay_fu1 if jhu_source=="fu1"      & er_stay_fu1 <.
replace er_stay_final = er_stay_fu2 if jhu_source=="fu2"      & er_stay_fu2 <.
replace er_stay_final = er_stay_p   if jhu_source=="pilot"    & er_stay_p   <.

replace er_stay_final = er_stay_p   if missing(er_stay_final) & er_stay_p   <.
replace er_stay_final = er_stay_b   if missing(er_stay_final) & er_stay_b   <.
replace er_stay_final = er_stay_fu1 if missing(er_stay_final) & er_stay_fu1 <.
replace er_stay_final = er_stay_fu2 if missing(er_stay_final) & er_stay_fu2 <.
tab er_stay_final,m 

* ER stay (6-month) from the same visit where JHU was collected
gen er_stay_6month_final = .

replace er_stay_6month_final = er_stay_6month_b   if jhu_source=="baseline" & er_stay_6month_b   <.
replace er_stay_6month_final = er_stay_6month_fu1 if jhu_source=="fu1"      & er_stay_6month_fu1 <.
replace er_stay_6month_final = er_stay_6month_fu2 if jhu_source=="fu2"      & er_stay_6month_fu2 <.
replace er_stay_6month_final = er_stay_6month_p   if jhu_source=="pilot"    & er_stay_6month_p   <.

replace er_stay_6month_final = er_stay_6month_p   if missing(er_stay_6month_final) & er_stay_6month_p   <.
replace er_stay_6month_final = er_stay_6month_b   if missing(er_stay_6month_final) & er_stay_6month_b   <.
replace er_stay_6month_final = er_stay_6month_fu1 if missing(er_stay_6month_final) & er_stay_6month_fu1 <.
replace er_stay_6month_final = er_stay_6month_fu2 if missing(er_stay_6month_final) & er_stay_6month_fu2 <.
replace er_stay_6month_final = . if er_stay_final != 1 
tab er_stay_6month_final,m

//hospital stay 
* Hospital stay from the same visit where JHU was collected
gen hospital_stay_final = .

replace hospital_stay_final = hospital_stay_b   if jhu_source=="baseline" & hospital_stay_b   <.
replace hospital_stay_final = hospital_stay_fu1 if jhu_source=="fu1"      & hospital_stay_fu1 <.
replace hospital_stay_final = hospital_stay_fu2 if jhu_source=="fu2"      & hospital_stay_fu2 <.
replace hospital_stay_final = hospital_stay_p   if jhu_source=="pilot"    & hospital_stay_p   <.

replace hospital_stay_final = hospital_stay_p   if missing(hospital_stay_final) & hospital_stay_p   <.
replace hospital_stay_final = hospital_stay_b   if missing(hospital_stay_final) & hospital_stay_b   <.
replace hospital_stay_final = hospital_stay_fu1 if missing(hospital_stay_final) & hospital_stay_fu1 <.
replace hospital_stay_final = hospital_stay_fu2 if missing(hospital_stay_final) & hospital_stay_fu2 <.
tab hospital_stay_final,m

gen hospital_stay_6month_final = .

replace hospital_stay_6month_final = hospital_stay_6month_b   if jhu_source=="baseline" & hospital_stay_6month_b   <.
replace hospital_stay_6month_final = hospital_stay_6month_fu1 if jhu_source=="fu1"      & hospital_stay_6month_fu1 <.
replace hospital_stay_6month_final = hospital_stay_6month_fu2 if jhu_source=="fu2"      & hospital_stay_6month_fu2 <.
replace hospital_stay_6month_final = hospital_stay_6month_p   if jhu_source=="pilot"    & hospital_stay_6month_p   <.

replace hospital_stay_6month_final = hospital_stay_6month_p   if missing(hospital_stay_6month_final) & hospital_stay_6month_p   <.
replace hospital_stay_6month_final = hospital_stay_6month_b   if missing(hospital_stay_6month_final) & hospital_stay_6month_b   <.
replace hospital_stay_6month_final = hospital_stay_6month_fu1 if missing(hospital_stay_6month_final) & hospital_stay_6month_fu1 <.
replace hospital_stay_6month_final = hospital_stay_6month_fu2 if missing(hospital_stay_6month_final) & hospital_stay_6month_fu2 <.

replace hospital_stay_6month_final = . if hospital_stay_final != 1
tab hospital_stay_6month_final,m


