replace record_id_pilot=30 if merge_id==25
replace record_id_pilot=8 if merge_id==32
replace record_id_pilot=7 if merge_id==34

replace record_id_pilot=11 if merge_id==36
replace record_id_pilot=22 if merge_id==38
replace record_id_pilot=109 if merge_id==41
replace record_id_pilot=28 if merge_id==49
replace record_id_pilot=31 if merge_id==50

replace record_id_pilot=123 if merge_id==55
replace record_id_pilot=117 if merge_id==67
replace record_id_pilot=60 if merge_id==77
replace record_id_pilot=41 if merge_id==118
replace record_id_pilot=21 if merge_id==121

replace record_id_pilot=116 if merge_id==2332
replace record_id_pilot=12 if merge_id==4847

list record_id_pilot record_id_main if overlap_main_pilot==1

gen survey_date = date(consentdate_pilot, "MDY")
format survey_date %td
