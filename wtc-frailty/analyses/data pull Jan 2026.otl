use "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\all done 0919 Jan 2026.dta",clear 

keep if !missing(jhu_source)


gen has_any_mental_condition_final = has_certPTSD_final == 1 | has_certANX_final == 1 | has_certDEP_final == 1 | has_certSA_final
rename has_any_mental_condition_final has_any_ment_cond

gen has_any_BUT_mentalhealth = has_any_cert_final == 1 & has_any_ment_cond == 0


gen bmi_Group_combined = bmi_Group_final
replace bmi_Group_combined = "Normal/Underweight" if inlist(bmi_Group_final, "Normal", "Underweight")
drop bmi_Group_final
rename bmi_Group_combined bmi_Group_final

gen exposure_combined = exposure_final
replace exposure_combined = "High/Very High" if inlist(exposure_final, "High", "Very High")
drop exposure_final
rename exposure_combined exposure_final

gen education_recode = education_final

replace education_recode = "<=High school" if inlist(education_final, "<HS Grad", "HS Grad")
replace education_recode = "Some college"  if education_final == "<BA/BS"
replace education_recode = "College"       if inlist(education_final, "BA/BS", "Grad Sch")
replace education_recode = ""               if education_final == "Unknown"

drop education_final
rename education_recode education_final

replace race_final = "" if race_final == "Unknown"

gen income_cat_final = .

replace income_cat_final = 1 if inlist(income_category,"$0-$10K",">$10-20K",">$20-30K",">$30-40K")
replace income_cat_final = 2 if inlist(income_category,">$40-50K",">$50-60K",">$60-70K",">$70-80K")
replace income_cat_final = 3 if inlist(income_category,">$80-90K",">$90-100K",">$100-110K",">$110-120K",">$120-130K",">$130-140K",">$140")

replace income_cat_final = . if income_category=="M"

label define income_cat_lbl 1 "Low (<40K)" 2 "Middle (40–80K)" 3 "High (>80K)"
label values income_cat_final income_cat_lbl

tab income_category
tab income_cat_final


*label define adl_cat 0 "Not fully independent" 1 "Independent" 2 "Unknown"
tab adl_cat_final

gen adl_cat_final2 = adl_cat_final
replace adl_cat_final2 = . if adl_cat_final2 == 2
tab adl_cat_final2,m

keep if adl_cat_final2!=.

local vars jhu_cat_final fesi_cat_final fall_risk_final falls_year_final ///
           moca_cat_final callahan_cat_final soc_4_categories_final ///
           exposure_final age_group gender_final race_final ///
           bmi_Group_final education_final smoking_status_final ///
           income_cat_final has_any_ment_cond has_any_BUT_mentalhealth ///
		   has_certURD_final has_certPTSD_final has_certCancer_final has_certGERD_final has_any_cert_final

foreach v of local vars {
    di "=============================="
    di "Chi-square test: adl_cat_final2 vs `v'"
    tab adl_cat_final2 `v', chi2 m
}

ttest n_certs_final,by(adl_cat_final2)
ttest age_at_jhu,by(adl_cat_final2)

