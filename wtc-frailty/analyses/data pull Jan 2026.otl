* drop any leftovers that still look non-drug / broken
replace generic_std = "" if regexm(generic_std, ///
"^AND$|^OTH$|^AIR$|^CORE$|^CHLORIDE$|^CHLORIDE A OSOL$|^API ENIN$|^ARLIC$|^BIOXYL S$|^CONSTIPATION$|^DON T KNOW$|^PAIN MED$|^BLOOD THINN$|^NSAID$|^STATIN$|^THYROID$|^INSULIN$|^NITRO$|^SPARY$|^SO NETA$|^NSI$|^NASO$")
drop if generic_std==""

replace generic_std = trim(regexr(generic_std, " +", " "))
tab generic_std

*=====================================================*
* FINAL AGGRESSIVE CLEAN + CORE CATEGORY COLLAPSE     *
*=====================================================*

replace generic_std = upper(trim(generic_std))
replace generic_std = regexr(generic_std, "[ ]+", " ")
replace generic_std = trim(generic_std)

* ----------------------------
* brand -> generic / core word
* ----------------------------
replace generic_std = "NAPROXEN"         if inlist(generic_std, "ALLEVE")
