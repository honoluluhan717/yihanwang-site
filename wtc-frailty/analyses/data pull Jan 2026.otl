H="certification done"
use "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\geri done 0902 Jan 2026.dta", clear

* --- Categories to finalize ---
local cats ANX Cancer DEP EXT GERD ILD OAD PTSD SA SP SRC URD

* --- _final = 1 if either _main or _pilot is 1 (treat missings as 0)
foreach c of local cats {
    capture confirm variable has_cert`c'_main
    if _rc gen byte has_cert`c'_main = 0
    replace has_cert`c'_main = 0 if missing(has_cert`c'_main)

    capture confirm variable has_cert`c'_pilot
    if _rc gen byte has_cert`c'_pilot = 0
    replace has_cert`c'_pilot = 0 if missing(has_cert`c'_pilot)

    gen byte has_cert`c'_final = (has_cert`c'_main==1 | has_cert`c'_pilot==1)
}

* --- Any & count from the _final set
egen has_any_cert_final = rowmax( ///
    has_certANX_final has_certCancer_final has_certDEP_final has_certEXT_final has_certGERD_final ///
    has_certILD_final has_certOAD_final has_certPTSD_final has_certSA_final has_certSP_final ///
    has_certSRC_final has_certURD_final)

egen n_certs_final = rowtotal( ///
    has_certANX_final has_certCancer_final has_certDEP_final has_certEXT_final has_certGERD_final ///
    has_certILD_final has_certOAD_final has_certPTSD_final has_certSA_final has_certSP_final ///
    has_certSRC_final has_certURD_final)

	
* Tabulate each _final flag + any + count
ds has_cert*_final has_any_cert_final n_certs_final
foreach v of varlist `r(varlist)' {
    di "=============================="
    di "Tabulation of `v'"
    tab `v', missing
}

drop _merge 
drop record_id

save "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\all done 0919 Jan 2026.dta", replace


H="Hannah paper revision"

use "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\all done 0919 Jan 2026.dta",clear

drop if jhu_source==""

preserve
contract n_certs_final

* Total sample size
egen total = total(_freq)

* Percentage
gen pct = 100 * _freq / total

* Label
gen lab = string(_freq) + " (" + string(pct,"%4.1f") + "%)"

* Graph
twoway ///
    (bar _freq n_certs_final, ///
        barwidth(0.8) ///
        fcolor(black) ///
        lcolor(black)) ///
    (scatter _freq n_certs_final, ///
        mlabel(lab) ///
        msymbol(none) ///
        mlabposition(12) ///
        mlabcolor(black)), ///
    legend(off) ///
    xtitle("Number of Certifications") ///
    ytitle("Number of Participants") ///
    title("Distribution of Certifications") ///
    ylabel(0(10)100)

restore

