replace income_cat_final = 2 if inlist(income_category,">$40-50K",">$50-60K",">$60-70K",">$70-80K",">$80-90K") | inlist(income_category, ">$90-100K",">$100-110K",">$110-120K",">$120-130K",">$130-140K",">$140")
