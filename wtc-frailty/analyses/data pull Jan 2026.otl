use "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\soc&exposure_complete 0902 Jan 2026.dta",clear 

preserve 
//get bmi group with jhu source from the baseline 
* --- Final BMI group (main): closest visit to survey_date_baseline; if missing, use prior visit ---

* 1) baseline date ? %td (works whether string or numeric)
capture confirm numeric variable survey_date_baseline
if _rc gen double _sdb = daily(survey_date_baseline,"DMY")
else    gen double _sdb = survey_date_baseline
format _sdb %td

* 2) visit dates ? %td helpers
forvalues i=1/20 {
    capture confirm numeric variable visit_date`i'
    if _rc gen double _vd`i' = daily(visit_date`i',"DMY")
    else    gen double _vd`i' = visit_date`i'
    format _vd`i' %td
}

* 3) index of closest visit (ignore missing dates)
gen double __min = .
gen byte   k     = .
forvalues i=1/20 {
    replace k     = `i' if _vd`i'<. & (missing(__min) | abs(_vd`i' - _sdb) < __min)
    replace __min = abs(_vd`i' - _sdb) if k==`i'
}

* 4) treat "Not reported" as missing
forvalues i=1/20 {
    replace bmi_Group`i' = "" if lower(strtrim(bmi_Group`i'))=="not reported"
}

* 5) take BMI group at closest visit; if empty, backfill from prior visits
gen str20 bmi_Group_baseline = ""
forvalues i=1/20 {
    replace bmi_Group_baseline = bmi_Group`i' if k==`i'
}
forvalues j=19(-1)1 {
    replace bmi_Group_baseline = bmi_Group`j' if bmi_Group_baseline=="" & k>`j' & bmi_Group`j'!=""
}

drop _vd1-_vd20 _sdb __min k
keep merge_id record_id_main record_id_pilot bmi_Group_baseline
tab bmi_Group_baseline,m
keep if record_id_main!=.
tempfile baseline 
save `baseline'
restore 


preserve 
//get bmi group with jhu source from the first follow up 
* BMI group at first follow-up (closest to survey_date_firstfp; backfill from prior if missing)

* 1) Anchor date -> %td
capture confirm numeric variable survey_date_firstfp
if _rc gen double _sdf = daily(survey_date_firstfp,"DMY")
else    gen double _sdf = survey_date_firstfp
format _sdf %td

* 2) Visit dates -> %td helpers
forvalues i=1/20 {
    capture confirm numeric variable visit_date`i'
    if _rc gen double _vd`i' = daily(visit_date`i',"DMY")
    else    gen double _vd`i' = visit_date`i'
    format _vd`i' %td
}

* 3) Closest visit index
gen double __min = .
gen byte   k     = .
forvalues i=1/20 {
    replace k     = `i' if _vd`i'<. & (missing(__min) | abs(_vd`i' - _sdf) < __min)
    replace __min = abs(_vd`i' - _sdf) if k==`i'
}

* 4) Treat "Not reported" as missing
forvalues i=1/20 {
    replace bmi_Group`i' = "" if lower(strtrim(bmi_Group`i'))=="not reported"
}

* 5) Final value: pick closest; if empty, use prior visits
capture drop bmi_Group_first_fp
gen str20 bmi_Group_first_fp = ""
forvalues i=1/20 {
    replace bmi_Group_first_fp = bmi_Group`i' if k==`i'
}
forvalues j=19(-1)1 {
    replace bmi_Group_first_fp = bmi_Group`j' if bmi_Group_first_fp=="" & k>`j' & bmi_Group`j'!=""
}

drop _vd1-_vd20 _sdf __min k
keep merge_id record_id_main record_id_pilot bmi_Group_first_fp
tab bmi_Group_first_fp,m
tempfile firstfp
save `firstfp'

restore 


preserve 
//get bmi group with jhu source from the pilot 
* BMI group (pilot): closest visit to survey_date_pilot; if missing, use prior visit

* anchor date -> %td (works whether string or numeric)
capture confirm numeric variable survey_date_pilot
if _rc gen double _sdp = daily(survey_date_pilot,"DMY")
else    gen double _sdp = survey_date_pilot
format _sdp %td

* index of closest visit (use vis1dt–vis16dt directly)
gen double __min = .
gen byte   k     = .
forvalues i=1/16 {
    replace k     = `i' if vis`i'dt<. & (missing(__min) | abs(vis`i'dt - _sdp) < __min)
    replace __min = abs(vis`i'dt - _sdp) if k==`i'
}

* treat "Not reported" as missing
forvalues i=1/16 {
    replace bmi_Group`i'_p = "" if lower(strtrim(bmi_Group`i'_p))=="not reported"
}

* take BMI group at closest visit; if empty, backfill from prior visits
capture drop bmi_Group_pilot
gen str20 bmi_Group_pilot = ""
forvalues i=1/16 {
    replace bmi_Group_pilot = bmi_Group`i'_p if k==`i'
}
forvalues j=15(-1)1 {
    replace bmi_Group_pilot = bmi_Group`j'_p if bmi_Group_pilot=="" & k>`j' & bmi_Group`j'_p!=""
}

drop _sdp __min k
keep merge_id record_id_main record_id_pilot bmi_Group_pilot 
tab bmi_Group_pilot,m
keep if record_id_pilot!=.
tempfile pilot
save `pilot'

restore 

preserve 
use `pilot'
merge 1:m record_id_pilot using `firstfp',nogen 
merge m:1 record_id_main using `baseline',nogen 
tempfile merge 
save `merge'
restore 


merge 1:1 merge_id using `merge',nogen 

gen bmi_Group_final=""
replace bmi_Group_final=bmi_Group_pilot if jhu_source=="pilot"
replace bmi_Group_final=bmi_Group_baseline if jhu_source=="baseline"
replace bmi_Group_final=bmi_Group_first_fp if jhu_source=="fu1"

* Fill bmi_Group_final when jhu_source is missing:
capture confirm string variable jhu_source
if _rc {
    * jhu_source is numeric
    replace bmi_Group_final = bmi_Group_pilot    if missing(jhu_source) & bmi_Group_final=="" & bmi_Group_pilot!=""
    replace bmi_Group_final = bmi_Group_baseline if missing(jhu_source) & bmi_Group_final=="" & bmi_Group_baseline!=""
    replace bmi_Group_final = bmi_Group_first_fp if missing(jhu_source) & bmi_Group_final=="" & bmi_Group_first_fp!=""
}
else {
    * jhu_source is string
    replace bmi_Group_final = bmi_Group_pilot    if (missing(jhu_source) | strtrim(jhu_source)=="") & bmi_Group_final=="" & bmi_Group_pilot!=""
    replace bmi_Group_final = bmi_Group_baseline if (missing(jhu_source) | strtrim(jhu_source)=="") & bmi_Group_final=="" & bmi_Group_baseline!=""
    replace bmi_Group_final = bmi_Group_first_fp if (missing(jhu_source) | strtrim(jhu_source)=="") & bmi_Group_final=="" & bmi_Group_first_fp!=""
}

tab bmi_Group_final, m

