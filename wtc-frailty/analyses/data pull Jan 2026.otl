order record_id merge_id survey_date_pilot survey_date_baseline survey_date_firstfp survey_date_secondfp survey_date_thirdfp,first

//validity check 
duplicates report merge_id

tab unique_in_main 
tab unique_in_pilot
tab overlap_main_pilot

list record_id_main record_id_pilot merge_id if overlap_main_pilot==1


save "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\initial data\merged to pilot\MERGED_ALL Jan 2026.dta",replace

