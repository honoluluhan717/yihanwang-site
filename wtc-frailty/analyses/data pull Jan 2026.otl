save "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\initial data\merged to pilot\WTC Pilot_Database.dta",replace

import delimited "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\initial data\merged to pilot\WTCPilot_Data.csv",clear
