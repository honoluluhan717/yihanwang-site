H="fall risk compare"
log using "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\output\fall risk compare 020926.smcl",replace 

use "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\int data\all done 0919 Jan 2026.dta",clear 

keep if !missing(jhu_source)

foreach var in survey_date_pilot survey_date_baseline survey_date_firstfp survey_date_secondfp survey_date_thirdfp {
	di "`var': " _c
    count if !missing(`var')
}

*==================== PILOT ====================*
preserve
keep if !missing(survey_date_pilot)


gen falls_test = (falls_afraid == 1 | falls_year == 1)
tab falls_test fall_risk_final

list record_id_main record_id_pilot if falls_test==1 & fall_risk_final!=1 

restore


*==================== BASELINE ====================*
preserve
keep if !missing(survey_date_baseline)


gen falls_test_b = (falls_afraid_b == 1 | falls_year_b == 1)
tab falls_test_b fall_risk_b

list record_id_main record_id_pilot if falls_test_b==1 & fall_risk_b!=1 

restore


*==================== FIRST FOLLOW-UP ====================*
preserve
keep if !missing(survey_date_firstfp)


gen falls_test_fu1 = (falls_afraid_fu1 == 1 | falls_year_fu1 == 1)
tab falls_test_fu1 fall_risk_fu1

list record_id_main record_id_pilot if falls_test_fu1==1 & fall_risk_fu1!=1 
list record_id_main record_id_pilot if falls_test_fu1!=1 & fall_risk_fu1==1 


restore


*==================== SECOND FOLLOW-UP ====================*
preserve
keep if !missing(survey_date_secondfp)


gen falls_test_fu2 = (falls_afraid_fu2 == 1 | falls_year_fu2 == 1)
tab falls_test_fu2 fall_risk_fu2

list record_id_main record_id_pilot if falls_test_fu2==1 & fall_risk_fu2!=1 

restore



translate "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\output\fall risk compare 020926.smcl" "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\output\fall risk compare 020926.pdf"

log close 

H="**************"


H="polypharmacy analyses"
log using "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\output\Polypharmacy 03.03.smcl",replace 

*---------------------------------------
* Polypharmacy data 
*---------------------------------------

clear all
set more off

* 1. Load data
import delimited "\\researchsan02a\Shr3\PM\DC_FK Frailty assessment\RDR FK250129 Frailty\FK250129_IAMQ_self_rep_meds(1).csv", clear stringcols(_all)

* 2. Basic checks
count
egen tag_id = tag(extractid)
count if tag_id
drop tag_id

* 3. Rename variables
rename iamq_med_01 currently_taking
rename iamq_med_02 brand_name
rename iamq_med_03 generic_name
rename iamq_med_04 form_of_med
rename iamq_med_05 other_form
rename iamq_med_06 quantity_or_strength
rename iamq_med_07 dose_measure
rename iamq_med_08 dose_measure_other
rename iamq_med_09 frequency_of_use
rename iamq_med_09a frequency_other
rename iamq_med_10 reason_code1
rename iamq_med_11 reason_code2
rename iamq_med_12 reason_other
rename iamq_med_13 when_start_taking
rename iamq_med_14 start_taking_range 
rename iamq_med_15 end_taking_range
rename iamq_med_16 time_units

* 4. Frequency tables
tab currently_taking, missing
tab comment currently_taking

* 5. Check duplicates within visit
* Brand name duplicates
gen brand_trim = trim(brand_name)
duplicates report extractid visit_number brand_trim
*duplicates list extractid visit_number brand_trim

* Generic name duplicates
gen generic_clean = lower(generic_name)
replace generic_clean = subinstr(generic_clean,"*","",.)
replace generic_clean = subinstr(generic_clean,"prn","",.)
replace generic_clean = trim(generic_clean)
duplicates report extractid visit_number generic_clean
*duplicates list extractid visit_number generic_clean

* 6. Length summaries
gen len_brand = length(brand_name)
gen len_generic = length(generic_name)
summ len_brand if currently_taking=="Yes"
summ len_generic if currently_taking=="Yes"

* 7. Create ID-visit variable
gen id_visit = extractid + "_" + visit_number

* 8. Keep visits with meds
preserve
keep if currently_taking=="Yes"

* 9. Compute rx counts per visit
gen taking = currently_taking == "Yes"
collapse (count) rxcount=taking, by(id_visit)
tempfile rxcounts
save `rxcounts'
restore

* 10. Merge rxcounts back
bysort id_visit: keep if _n==1
merge 1:1 id_visit using `rxcounts', nogen

* 11. Convert visit dates
gen visit_date2 = date(when_start_taking,"MDY")
format visit_date2 %td
gen visit_year = year(visit_date2)

* 12. Set rxcount=0 when no meds
replace rxcount = 0 if comment=="No IAMQ self-reported medications data available for this visit"


* 13. Longitudinal summaries
bys extractid: gen nvisits = _N
tab nvisits
tab visit_year

* 14. Distribution of rxcount
summ rxcount, detail
*histogram rxcount, bin(50) percent

* 15. Extreme cases
tab rxcount if rxcount>50
list extractid visit_number rxcount if rxcount==52
list extractid visit_number rxcount if rxcount==57

* 16. Rxcount by year
graph box rxcount, over(visit_year)

* Most recent visit 

* 18. Cross-sectional subset 2019+
keep if visit_year>=2019
sum rxcount
histogram rxcount, percent
tab rxcount


translate "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\output\Polypharmacy 03.03.smcl" "J:\Geriatrics\Research\Active Studies\Ko, WTC II\Data Analysis\Files from Yihan\output\Polypharmacy 03.03.pdf"

log close 

H="clean clean clean "
*further cleaning steps 

*==============================
* CLEAN GENERIC NAME (ONE CHUNK)
*==============================

gen generic_std = upper(trim(generic_name))

* Remove dosage / units
replace generic_std = regexr(generic_std, "[0-9]+(\.[0-9]+)?\s*(MG|ML|MCG|G|%|IU)", "")

* Remove forms
replace generic_std = regexr(generic_std, ///
"(TABLET|TAB|CAPSULE|CAP|INHALER|SPRAY|SOLUTION|PATCH|CREAM|OINTMENT|GEL|DROP|NEB|NEBULIZER|INJECTION|SYRUP)", "")

* Remove frequency / instructions
replace generic_std = regexr(generic_std, ///
"(PRN|QD|QID|BID|TID|DAILY|NIGHTLY|ONCE|TWICE|EVERY.*|AS NEEDED)", "")

* Remove symbols / punctuation
replace generic_std = regexr(generic_std, "[^A-Z ]", "")
replace generic_std = trim(regexr(generic_std, " +", " "))

* Drop garbage
replace generic_std = "" if length(generic_std)<=2
replace generic_std = "" if regexm(generic_std, ///
"UNKNOWN|CANNOT|NOT SURE|MEDICATION|SUPPLEMENT|VITAMIN|BLOOD PRESSURE|ANTIBIOTIC|EYE DROPS|CREAM")

* Fix common misspellings / unify categories
replace generic_std = "ALBUTEROL" if regexm(generic_std, "ALBUTER")
replace generic_std = "AMLODIPINE" if regexm(generic_std, "AMLOD")
replace generic_std = "ATORVASTATIN" if regexm(generic_std, "ATORV")
replace generic_std = "ASPIRIN" if regexm(generic_std, "ASPIR|ASA")
replace generic_std = "ACETAMINOPHEN" if regexm(generic_std, "ACETAM")
replace generic_std = "CETIRIZINE" if regexm(generic_std, "CETIRI")
replace generic_std = "ALLOPURINOL" if regexm(generic_std, "ALLOP")
replace generic_std = "ALPRAZOLAM" if regexm(generic_std, "ALPRAZ")
replace generic_std = "BUDESONIDE" if regexm(generic_std, "BUDESO")
replace generic_std = "AZELASTINE" if regexm(generic_std, "AZELAS")
replace generic_std = "CLOPIDOGREL" if regexm(generic_std, "CLOPID")
replace generic_std = "ESCITALOPRAM" if regexm(generic_std, "ESCIT")
replace generic_std = "ESOMEPRAZOLE" if regexm(generic_std, "ESOMEP")
replace generic_std = "FAMOTIDINE" if regexm(generic_std, "FAMOT")

* Keep first drug if combination
replace generic_std = word(generic_std,1)

* Final clean list
drop if generic_std==""

*==============================
* VERY CLEAN GENERIC NAME LIST
*==============================

capture drop generic_std
gen generic_std = upper(trim(generic_name))

* fill from brand if generic missing
replace generic_std = upper(trim(brand_name)) if missing(generic_std) | generic_std==""

* remove leading/trailing junk and normalize spaces
replace generic_std = subinstr(generic_std, char(9), " ", .)
replace generic_std = regexr(generic_std, "^[^A-Z0-9]+", "")
replace generic_std = regexr(generic_std, "[^A-Z0-9]+$", "")
replace generic_std = regexr(generic_std, "[ ]+", " ")

* collapse obvious vitamins / supplements first
replace generic_std = "VITAMIN" if regexm(generic_std, ///
"VIT|VITAMIN|MULTIVIT|CENTRUM|BIOTIN|CYANOCOBALAMIN|CHOLECALCIFEROL|ERGOCALCIFEROL|ASCORBIC|B12|B 12|B-12|B COMPLEX|D3|COQ10|CO Q10|CQ 10|C0Q10|COENZYME Q10|FISH OIL|OMEGA ?3|COLLAGEN|CRANBERRY|APPLE CIDER|CINNAMON|GLUCOSAMINE|CHONDROITIN|PROBIOTIC|ALIGN|ACIDOPH|AMINO ACID|AMINO ACIDS|5HTP|FERROUS SULFATE|CALCIUM|MAGNESIUM")

* common brand to generic
replace generic_std = "IBUPROFEN" if regexm(generic_std, "ADVIL|ALEVE") & !regexm(generic_std, "TYLENOL")
replace generic_std = "ACETAMINOPHEN" if regexm(generic_std, "TYLENOL")
replace generic_std = "ARIPIPRAZOLE" if regexm(generic_std, "ABILIFY")
replace generic_std = "FLUTICASONE SALMETEROL" if regexm(generic_std, "ADVAIR")
replace generic_std = "SPIRONOLACTONE" if regexm(generic_std, "ALDACTONE")
replace generic_std = "PIOGLITAZONE" if regexm(generic_std, "ACTOS")
replace generic_std = "ASPIRIN" if regexm(generic_std, "ECOTRIN|BAYER|BABY ASPIRIN|ASA|ASPRIN|AASPRIN|ACARD")
replace generic_std = "LORAZEPAM" if regexm(generic_std, "ATIVAN")
replace generic_std = "APIXABAN" if regexm(generic_std, "ELIQUIS|ELOQUIS")
replace generic_std = "ROSUVASTATIN" if regexm(generic_std, "CRESTOR")
replace generic_std = "CELECOXIB" if regexm(generic_std, "CELEBREX")
replace generic_std = "FEXOFENADINE" if regexm(generic_std, "ALLEGRA")
replace generic_std = "LORATADINE" if regexm(generic_std, "CLARITIN|CLARITAN")
replace generic_std = "AZELASTINE" if regexm(generic_std, "ASTELIN|ASTEPRO")
replace generic_std = "LOSARTAN" if regexm(generic_std, "COZAAR")
replace generic_std = "IRBESARTAN" if regexm(generic_std, "AVAPRO")
replace generic_std = "NEBIVOLOL" if regexm(generic_std, "BYSTOLIC")
replace generic_std = "MESALAMINE" if regexm(generic_std, "CANASA")
replace generic_std = "TICAGRELOR" if regexm(generic_std, "BRILINTA")
replace generic_std = "DULOXETINE" if regexm(generic_std, "CYMBALTA")
replace generic_std = "BUDESONIDE FORMOTEROL" if regexm(generic_std, "SYMBICORT")
replace generic_std = "BREXPIPRAZOLE" if regexm(generic_std, "REXULTI")

* remove strength, units, forms, route, and frequency
replace generic_std = regexr(generic_std, "[0-9]+([.][0-9]+)?[ ]*(MG|MCG|G|GM|ML|L|IU|MEQ|MMOL|%)", " ")
replace generic_std = regexr(generic_std, "[0-9]+/[0-9]+", " ")
replace generic_std = regexr(generic_std, "(TABLET|TABLETS|TAB|TABS|CAPSULE|CAPSULES|CAP|CAPS|INHALER|INH|SPRAY|SPRAYS|SOLUTION|SOLUTIONS|SOLN|PATCH|PATCHES|CREAM|OINTMENT|OINT|GEL|GELS|DROP|DROPS|NEB|NEBS|NEBULIZER|NEBULIZERS|INJECTION|INJECTOR|SYRUP|AUTOINJECTOR|AUTO INJECTOR|PEN|ORAL|TOPICAL|NASAL|OPHTHALMIC|EYE|GTT|GTTS|HFA|MDI|DR|ER|XR|SR|EC)", " ")
replace generic_std = regexr(generic_std, "(PRN|QD|QOD|BID|TID|QID|HS|QHS|PO|DAILY|NIGHTLY|ONCE|TWICE|THREE TIMES A WEEK|TWICE DAILY|EVERY OTHER DAY|AT BEDTIME|RARELY|SOMETIMES)", " ")

* remove salt names / chemistry tails that clutter generic
replace generic_std = regexr(generic_std, "(HYDROCHLORIDE|HCL|SODIUM|CALCIUM|BESYLATE|BISULFATE|FUMARATE|MALEATE|OXALATE|SUCCINATE|MONOHYDRATE|HYDRATE|TARTRATE|POTASSIUM|ACETATE|PHOSPHATE|MESYLATE|CILEXETIL|MEDOXOMIL|TRIHYDRATE|STRONTIUM)", " ")

* remove punctuation / weird marks after above steps
replace generic_std = regexr(generic_std, "[^A-Z ]", " ")
replace generic_std = regexr(generic_std, "[ ]+", " ")
replace generic_std = trim(generic_std)

* fix common misspellings / noisy variants
replace generic_std = "ALBUTEROL" if regexm(generic_std, "ALBUTER|ALUTEROL")
replace generic_std = "ALFUZOSIN" if regexm(generic_std, "AFLUZOSIN")
replace generic_std = "ALPRAZOLAM" if regexm(generic_std, "ALPRAZ")
replace generic_std = "AMITRIPTYLINE" if regexm(generic_std, "AMITR")
replace generic_std = "AMLODIPINE" if regexm(generic_std, "AMLOD|AMOLOD|AMLODOP|AMLODP|AMOLOD|AMODOL")
replace generic_std = "AMOXICILLIN" if regexm(generic_std, "AMOXICIL")
replace generic_std = "ANASTROZOLE" if regexm(generic_std, "ANASTR")
replace generic_std = "ATORVASTATIN" if regexm(generic_std, "ATORV|ATROV|AORV|AVORSTAT")
replace generic_std = "AZELASTINE" if regexm(generic_std, "AZELAS")
replace generic_std = "BUDESONIDE" if regexm(generic_std, "BUDESO")
replace generic_std = "BUPROPION" if regexm(generic_std, "BUPROP")
replace generic_std = "CANDESARTAN" if regexm(generic_std, "CANDES|CANDIS")
replace generic_std = "CETIRIZINE" if regexm(generic_std, "CETIR|CETERI|CETRIZ|CITRIZ")
replace generic_std = "CHLORTHALIDONE" if regexm(generic_std, "CHLORTH")
replace generic_std = "CLONAZEPAM" if regexm(generic_std, "CLONAZ")
replace generic_std = "CLOPIDOGREL" if regexm(generic_std, "CLOPID")
replace generic_std = "COLCHICINE" if regexm(generic_std, "COLCH|COLDICINE")
replace generic_std = "DICLOFENAC" if regexm(generic_std, "DICLOF|DECLOF")
replace generic_std = "DESLORATADINE" if regexm(generic_std, "DESLORAT")
replace generic_std = "DIPHENHYDRAMINE" if regexm(generic_std, "DIPHENHYD|DYPHENHYD|DIFENHID")
replace generic_std = "DONEPEZIL" if regexm(generic_std, "DONEPEZ|DONAZEP")
replace generic_std = "DULOXETINE" if regexm(generic_std, "DULOXET")
replace generic_std = "EMPAGLIFLOZIN" if regexm(generic_std, "EMPAGLI")
replace generic_std = "ENALAPRIL" if regexm(generic_std, "ENALAPR|ENALIPR")
replace generic_std = "ESCITALOPRAM" if regexm(generic_std, "ESCITAL|ESCALOP|ESCITSL|ESCITS|ESCITALIP")
replace generic_std = "ESOMEPRAZOLE" if regexm(generic_std, "ESOMEP|ESMOP")
replace generic_std = "EZETIMIBE" if regexm(generic_std, "EZETI|EZETM")
replace generic_std = "FAMOTIDINE" if regexm(generic_std, "FAMOT|FAMAT")
replace generic_std = "FENOFIBRATE" if regexm(generic_std, "FENOFIB|FENOFEB")
replace generic_std = "FEXOFENADINE" if regexm(generic_std, "FEXOFEN")
replace generic_std = "MONTELUKAST" if regexm(generic_std, "MONTELUK")
replace generic_std = "CYCLOSPORINE" if regexm(generic_std, "CYCLOSPOR")
replace generic_std = "ACETAMINOPHEN" if regexm(generic_std, "ACETAMIN")
replace generic_std = "ASPIRIN" if regexm(generic_std, "ASPIRIN|ASA|ASPRIN|AASPRIN")
replace generic_std = "IBUPROFEN" if regexm(generic_std, "IBUPROFEN|ADVIL")
replace generic_std = "LORATADINE" if regexm(generic_std, "LORATADINE|CLARITIN|CLARITAN")
replace generic_std = "FEXOFENADINE" if regexm(generic_std, "ALLEGRA")
replace generic_std = "DICLOFENAC" if regexm(generic_std, "DUEXIS")==0 & regexm(generic_std, "DICLOF")

* common combos: keep standardized combo names
replace generic_std = "AMLODIPINE BENAZEPRIL" if regexm(generic_std, "AMLODIPINE.*BENAZEPRIL|BENAZEPRIL.*AMLODIPINE|BENZAPRIL")
replace generic_std = "AMLODIPINE OLMESARTAN" if regexm(generic_std, "AMLODIPINE.*OLMESARTAN|OLMESARTAN.*AMLODIPINE")
replace generic_std = "AMLODIPINE VALSARTAN" if regexm(generic_std, "AMLODIPINE.*VALSARTAN|VALSARTAN.*AMLODIPINE")
replace generic_std = "AMOXICILLIN CLAVULANATE" if regexm(generic_std, "AMOX.*CLAV|CLAVULANATE")
replace generic_std = "AZELASTINE FLUTICASONE" if regexm(generic_std, "AZELASTINE.*FLUTICASONE|FLUTICASONE.*AZELASTINE|DYMISTA")
replace generic_std = "BUDESONIDE FORMOTEROL" if regexm(generic_std, "BUDESONIDE.*FORMOTEROL|FORMOTEROL.*BUDESONIDE")
replace generic_std = "CARBIDOPA LEVODOPA" if regexm(generic_std, "CARBIDOPA.*LEVODOPA|LEVODOPA.*CARBIDOPA")
replace generic_std = "DUTASTERIDE TAMSULOSIN" if regexm(generic_std, "DUTASTERIDE.*TAMSULOSIN|TAMSULOSIN.*DUTASTERIDE")
replace generic_std = "EMPAGLIFLOZIN METFORMIN" if regexm(generic_std, "EMPAGLIFLOZIN.*METFORMIN|METFORMIN.*EMPAGLIFLOZIN")
replace generic_std = "DAPAGLIFLOZIN METFORMIN" if regexm(generic_std, "DAPAGLIFLOZIN.*METFORMIN|METFORMIN.*DAPAGLIFLOZIN")
replace generic_std = "EZETIMIBE SIMVASTATIN" if regexm(generic_std, "EZETIMIBE.*SIMVAST|SIMVAST.*EZETIMIBE")
replace generic_std = "FEXOFENADINE PSEUDOEPHEDRINE" if regexm(generic_std, "FEXOFENADINE.*PSEUDOEPHEDRINE|PSEUDOEPHEDRINE.*FEXOFENADINE")
replace generic_std = "CETIRIZINE PSEUDOEPHEDRINE" if regexm(generic_std, "CETIRIZINE.*PSEUDOEPHEDRINE|PSEUDOEPHEDRINE.*CETIRIZINE")
replace generic_std = "BUPRENORPHINE NALOXONE" if regexm(generic_std, "BUPRENORPHINE.*NALOXONE|NALOXONE.*BUPRENORPHINE")
replace generic_std = "BUTALBITAL ACETAMINOPHEN CAFFEINE" if regexm(generic_std, "BUTALBITAL.*ACETAMINOPHEN.*CAFFEINE|ACETAMINOPHEN.*CAFFEINE")
replace generic_std = "DORZOLAMIDE TIMOLOL" if regexm(generic_std, "DORZOLAMIDE.*TIMOLOL|TIMOLOL.*DORZOLAMIDE")

* drop vague / unusable items
replace generic_std = "" if regexm(generic_std, ///
"UNKNOWN|NOT SURE|CANNOT|DOES NOT REMEMBER|CANT REMEMBER|FORGOT NAME|MEDICATION|MEDS|PILL|BLOOD PRESSURE|CHOLESTEROL|ALLERGY|ANTIBIOTIC|ANTIFUNGAL|BLOOD THINNER|EYE DROPS|EYE GTTS|EAR DROPS|DRY EYE|SALINE|MIST|OXYGEN|DIALYSIS|BIRTH CONTROL|BACK PAIN|REFLUX|CREAM FOR|GEL|PATCH|SHOT|INHALER")
replace generic_std = "" if length(generic_std)<=1
replace generic_std = "" if inlist(generic_std,"AIR","CBD")
replace generic_std = trim(generic_std)

* optional: if after cleaning only one meaningless short token remains, drop it
replace generic_std = "" if length(generic_std)<=2

* final drop missing cleaned values
drop if generic_std==""

* review very clean list
sort generic_std
tab generic_std

*========================================
* FURTHER STEP: KEEP ONLY CORE DRUG WORD
*========================================

replace generic_std = upper(trim(generic_std))

* delete all numbers first
replace generic_std = regexr(generic_std, "[0-9]+", " ")

* remove leftover filler words
replace generic_std = regexr(generic_std, ///
"(MG|MCG|ML|G|GM|IU|MEQ|MMOL|PERCENT|TABLET|TABLETS|TAB|TABS|CAPSULE|CAPSULES|CAP|CAPS|INHALER|INH|SPRAY|SPRAYS|SOLUTION|SOLN|PATCH|PATCHES|CREAM|OINTMENT|OINT|GEL|GELS|DROP|DROPS|NEB|NEBS|NEBULIZER|NEBULIZERS|INJECTION|INJECTOR|PEN|SYRUP|AUTOINJECTOR|AUTO INJECTOR|ORAL|TOPICAL|NASAL|OPHTHALMIC|EYE|GTT|GTTS|HFA|MDI|DR|ER|XR|SR|EC|PRN|QD|QOD|BID|TID|QID|HS|QHS|PO|DAILY|NIGHTLY|ONCE|TWICE|SOMETIMES|RARELY|BEDTIME|ACTUATION|CHEWABLE|DELAYED RELEASE|EXTENDED RELEASE|RELEASE)", " ")

replace generic_std = regexr(generic_std, ///
"(HYDROCHLORIDE|HCL|SODIUM|CALCIUM|BESYLATE|BISULFATE|FUMARATE|MALEATE|OXALATE|SUCCINATE|MONOHYDRATE|HYDRATE|TARTRATE|POTASSIUM|ACETATE|PHOSPHATE|MESYLATE|CILEXETIL|MEDOXOMIL|TRIHYDRATE|STRONTIUM)", " ")

replace generic_std = regexr(generic_std, "[^A-Z ]", " ")
replace generic_std = regexr(generic_std, "[ ]+", " ")
replace generic_std = trim(generic_std)

* if contains the same drug word, keep only that word / combo
replace generic_std = "VITAMIN" if regexm(generic_std, ///
"VIT|MULTIVIT|BIOTIN|CYANOCOBALAMIN|CHOLECALCIFEROL|ERGOCALCIFEROL|ASCORBIC|B COMPLEX|B |B12|COQ|COENZYME|FISH OIL|OMEGA|GLUCOSAMINE|CHONDROITIN|PROBIOTIC|ALIGN|ACIDOPH|AMINO ACID|CALCIUM|MAGNESIUM|COLLAGEN|CRANBERRY|APPLE CIDER|CINNAMON")

replace generic_std = "ASPIRIN" if regexm(generic_std, "ASPIRIN|ASA|ASPRIN|AASPRIN|BABY ASPIRIN|ECOTRIN|BAYER|ACARD")
replace generic_std = "ACETAMINOPHEN" if regexm(generic_std, "ACETAMINOPHEN|TYLENOL")
replace generic_std = "IBUPROFEN" if regexm(generic_std, "IBUPROFEN|ADVIL")
replace generic_std = "NAPROXEN" if regexm(generic_std, "NAPROXEN|ALEVE")

replace generic_std = "ALBUTEROL" if regexm(generic_std, "ALBUTER|ALUTEROL")
replace generic_std = "ALFUZOSIN" if regexm(generic_std, "ALFUZOSIN|AFLUZOSIN")
replace generic_std = "ALLOPURINOL" if regexm(generic_std, "ALLOPURINOL")
replace generic_std = "ALPRAZOLAM" if regexm(generic_std, "ALPRAZ")
replace generic_std = "AMIODARONE" if regexm(generic_std, "AMIODARONE")
replace generic_std = "AMITRIPTYLINE" if regexm(generic_std, "AMITR")
replace generic_std = "AMLODIPINE" if regexm(generic_std, "AMLOD|AMOLOD|AMLODOP|AMLODP|AMODOL")
replace generic_std = "AMOXICILLIN" if regexm(generic_std, "AMOXICIL")
replace generic_std = "ANASTROZOLE" if regexm(generic_std, "ANASTR")
replace generic_std = "APIXABAN" if regexm(generic_std, "APIXABAN|ELIQUIS|ELOQUIS")
replace generic_std = "ARIPIPRAZOLE" if regexm(generic_std, "ARIPIPRAZOLE|ABILIFY")
replace generic_std = "ATENOLOL" if regexm(generic_std, "ATENOLOL")
replace generic_std = "ATORVASTATIN" if regexm(generic_std, "ATORV|ATROV|AORV|AVORSTAT|LIPITOR")
replace generic_std = "AZELASTINE" if regexm(generic_std, "AZELAS|ASTELIN|ASTEPRO")
