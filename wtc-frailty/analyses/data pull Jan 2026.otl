sort generic_std
tab generic_std

*========================================================*
* AGGRESSIVE SMART COLLAPSE TO CORE DRUG CATEGORY ONLY   *
*========================================================*

replace generic_std = upper(trim(generic_std))
replace generic_std = regexr(generic_std, "[0-9]+", "")
replace generic_std = regexr(generic_std, "[^A-Z ]", " ")
replace generic_std = regexr(generic_std, " +", " ")
